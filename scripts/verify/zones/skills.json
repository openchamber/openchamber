{
  "zone": "skills",
  "name": "Skill settings",
  "sources": ["packages/ui/src/components/sections/skills/SkillsPage.tsx", "packages/ui/src/components/sections/skills/SkillsSidebar.tsx"],
  "features": [
    {
      "id": "create",
      "name": "Creating skill drafts",
      "sources": ["packages/ui/src/components/sections/skills/SkillsPage.tsx", "packages/ui/src/components/sections/skills/SkillsSidebar.tsx", "packages/ui/src/components/sections/skills/skillLocations.ts"],
      "what": "A draft stays off disk until Create skill, validates its name and description, and writes to the chosen project location with its pending files.",
      "reach": "Settings > Skills > +.",
      "proof": "The chosen skill folder holds the description, instructions and pending file; Cancel and refused creation leave the draft unwritten.",
      "scenarios": [
        {
          "id": "project",
          "kind": "path",
          "title": "Create normalizes a name and writes the project document and a pending supporting file",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.create"},
            {"do": "click", "on": "skills.name", "clicks": 3},
            {"do": "type", "text": "Net Helper"},
            {"do": "field", "on": "skills.name", "equals": "net-helper"},
            {"do": "click", "on": "skills.location"},
            {"do": "click", "on": "skills.option", "text": "Project / OpenCode"},
            {"do": "click", "on": "skills.description"},
            {"do": "type", "text": "Review local changes"},
            {"do": "click", "on": "skills.editor"},
            {"do": "press", "key": "a", "mods": ["mod"]},
            {"do": "type", "text": "---\ndescription: Review local changes\n---\n\n# Review checklist\nRead the diff first."},
            {"do": "click", "on": "settings.rowButton", "item": "skills.supporting-files", "text": "Add file", "exact": true},
            {"do": "see", "on": "dialog.button", "text": "Create file", "exact": true, "disabled": true},
            {"do": "click", "on": "skills.filePath"},
            {"do": "type", "text": "docs/checklist.txt"},
            {"do": "click", "on": "skills.fileEditor"},
            {"do": "type", "text": "Check every changed file."},
            {"do": "click", "on": "dialog.button", "text": "Create file", "exact": true},
            {"do": "see", "on": "skills.file", "text": "docs/checklist.txt"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "exists": false},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/docs/checklist.txt", "exists": false},
            {"do": "click", "on": "dialog.button", "text": "Create skill", "exact": true},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "Review local changes"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "# Review checklist\nRead the diff first."},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/docs/checklist.txt", "equals": "Check every changed file."},
            {"do": "gone", "on": "skills.name"},
            {"do": "see", "on": "skills.row", "text": "net-helper", "exact": true}
          ]
        },
        {
          "id": "agents-location",
          "kind": "path",
          "title": "The project agents location writes to .agents and is discovered after reload",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.create"},
            {"do": "click", "on": "skills.name", "clicks": 3},
            {"do": "type", "text": "net-agents"},
            {"do": "click", "on": "skills.location"},
            {"do": "click", "on": "skills.option", "text": "Project / agents"},
            {"do": "click", "on": "skills.description"},
            {"do": "type", "text": "Agents compatibility skill"},
            {"do": "click", "on": "dialog.button", "text": "Create skill", "exact": true},
            {"do": "file.expect", "path": ".agents/skills/net-agents/SKILL.md", "contains": "Agents compatibility skill"},
            {"do": "file.expect", "path": ".opencode/skills/net-agents/SKILL.md", "exists": false},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "skills.row", "text": "net-agents", "exact": true, "timeout": 60},
            {"do": "field", "on": "skills.description", "equals": "Agents compatibility skill"}
          ]
        },
        {
          "id": "cancel",
          "kind": "path",
          "title": "Cancel closes a draft without writing its document or pending files",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.create"},
            {"do": "click", "on": "skills.location"},
            {"do": "click", "on": "skills.option", "text": "Project / OpenCode"},
            {"do": "click", "on": "skills.description"},
            {"do": "type", "text": "Discard me"},
            {"do": "click", "on": "settings.rowButton", "item": "skills.supporting-files", "text": "Add file", "exact": true},
            {"do": "click", "on": "skills.filePath"},
            {"do": "type", "text": "discard.txt"},
            {"do": "click", "on": "dialog.button", "text": "Create file", "exact": true},
            {"do": "see", "on": "skills.file", "text": "discard.txt"},
            {"do": "click", "on": "dialog.button", "text": "Cancel", "exact": true},
            {"do": "gone", "on": "skills.name"},
            {"do": "file.expect", "path": ".opencode/skills/new-skill", "exists": false},
            {"do": "gone", "on": "skills.file", "text": "discard.txt"}
          ]
        },
        {
          "id": "invalid",
          "kind": "break",
          "title": "Missing required fields disable Create and an invalid name reports its rule without writing",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.create"},
            {"do": "see", "on": "dialog.button", "text": "Create skill", "exact": true, "disabled": true},
            {"do": "click", "on": "skills.description"},
            {"do": "type", "text": "Validation draft"},
            {"do": "click", "on": "skills.name", "clicks": 3},
            {"do": "press", "key": "Backspace"},
            {"do": "see", "on": "dialog.button", "text": "Create skill", "exact": true, "disabled": true},
            {"do": "type", "text": "-invalid"},
            {"do": "click", "on": "dialog.button", "text": "Create skill", "exact": true},
            {"do": "see", "on": "toast", "text": "Skill name must be 1-64"},
            {"do": "field", "on": "skills.name", "equals": "-invalid"},
            {"do": "field", "on": "skills.description", "equals": "Validation draft"}
          ]
        },
        {
          "id": "taken",
          "kind": "break",
          "title": "An existing name is refused without replacing the original document",
          "steps": [
            {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Original helper\n---\nOriginal instructions."},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "see", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "click", "on": "skills.create"},
            {"do": "click", "on": "skills.name", "clicks": 3},
            {"do": "type", "text": "net-helper"},
            {"do": "click", "on": "skills.description"},
            {"do": "type", "text": "Replacement"},
            {"do": "click", "on": "dialog.button", "text": "Create skill", "exact": true},
            {"do": "see", "on": "toast", "text": "A skill with this name already exists"},
            {"do": "field", "on": "skills.description", "equals": "Replacement"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "Original instructions."}
          ]
        },
        {
          "id": "write-failure",
          "kind": "break",
          "title": "Failed creation keeps the complete project draft and retries successfully",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.create"},
            {"do": "click", "on": "skills.name", "clicks": 3},
            {"do": "type", "text": "net-retry"},
            {"do": "click", "on": "skills.location"},
            {"do": "click", "on": "skills.option", "text": "Project / OpenCode"},
            {"do": "click", "on": "skills.description"},
            {"do": "type", "text": "Retry this skill"},
            {"do": "network.block", "urls": ["*/api/config/skills/net-retry*"]},
            {"do": "click", "on": "dialog.button", "text": "Create skill", "exact": true},
            {"do": "see", "on": "toast", "text": "Failed to create skill"},
            {"do": "field", "on": "skills.name", "equals": "net-retry"},
            {"do": "field", "on": "skills.description", "equals": "Retry this skill"},
            {"do": "file.expect", "path": ".opencode/skills/net-retry/SKILL.md", "exists": false},
            {"do": "network.allow"},
            {"do": "click", "on": "dialog.button", "text": "Create skill", "exact": true},
            {"do": "file.expect", "path": ".opencode/skills/net-retry/SKILL.md", "contains": "Retry this skill"},
            {"do": "gone", "on": "skills.name"}
          ]
        }
      ]
    },
    {
      "id": "browse",
      "name": "Finding installed skills",
      "sources": ["packages/ui/src/components/sections/skills/SkillsSidebar.tsx", "packages/ui/src/components/sections/skills/SkillsPage.tsx"],
      "what": "Search matches names and descriptions; an unmatched query can be cleared with Escape.",
      "reach": "Settings > Skills > Search.",
      "proof": "Only the matching skill remains, Escape restores the list and selecting a skill opens its own document.",
      "scenarios": [{
        "id": "search",
        "kind": "path",
        "title": "Search recovers from no matches, opens the matching document and keeps built-in skills read-only",
        "steps": [
          {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Zebra checklist\n---\nOriginal instructions."},
          {"do": "file.write", "path": ".opencode/skills/net-other/SKILL.md", "content": "---\nname: net-other\ndescription: Other helper\n---\nOther instructions."},
          {"do": "open"},
          {"do": "click", "on": "sidebar.settings"},
          {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
          {"do": "see", "on": "skills.row", "text": "net-other", "exact": true},
          {"do": "click", "on": "skills.search"},
          {"do": "type", "text": "Zebra"},
          {"do": "see", "on": "skills.row", "text": "net-helper", "exact": true},
          {"do": "gone", "on": "skills.row", "text": "net-other", "exact": true},
          {"do": "click", "on": "skills.search", "clicks": 3},
          {"do": "type", "text": "zzzz-no-such-skill"},
          {"do": "gone", "on": "skills.row"},
          {"do": "see", "on": "dialog", "text": "Nothing matches"},
          {"do": "press", "key": "Escape"},
          {"do": "field", "on": "skills.search", "equals": ""},
          {"do": "see", "on": "skills.row", "text": "net-other", "exact": true},
          {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true},
          {"do": "field", "on": "skills.description", "equals": "Zebra checklist"},
          {"do": "see", "on": "skills.line", "text": "Original instructions."},
          {"do": "click", "on": "skills.row", "text": "OpenCode", "exact": true},
          {"do": "see", "on": "skills.description", "disabled": true},
          {"do": "gone", "on": "skills.editor"},
          {"do": "see", "on": "settings.rowButton", "item": "skills.supporting-files", "text": "Add file", "exact": true, "disabled": true},
          {"do": "click", "on": "skills.row", "text": "OpenCode", "exact": true, "button": "right"},
          {"do": "gone", "on": "menu.item"}
        ]
      }]
    },
    {
      "id": "edit",
      "name": "Editing and previewing skill documents",
      "what": "The description and Markdown frontmatter stay synchronized; existing text saves on blur or Cmd/Ctrl+Enter. Invalid or failed saves keep the edit available.",
      "reach": "Settings > Skills > an installed skill.",
      "proof": "Disk and reopened fields hold the edited description and instructions; Preview renders the heading without frontmatter; refused saves retain the original file.",
      "scenarios": [
        {
          "id": "document",
          "kind": "path",
          "title": "Description blur and Markdown Cmd/Ctrl+Enter save, Preview renders the body and reload keeps it",
          "steps": [
            {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Original helper\n---\nOriginal instructions."},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "field", "on": "skills.description", "equals": "Original helper"},
            {"do": "click", "on": "skills.description", "clicks": 3},
            {"do": "type", "text": "Updated helper"},
            {"do": "click", "on": "skills.editor"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "Updated helper"},
            {"do": "see", "on": "skills.line", "text": "description: Updated helper"},
            {"do": "press", "key": "a", "mods": ["mod"]},
            {"do": "type", "text": "---\ndescription: Document description\n---\n\n# Net heading\nUpdated instructions."},
            {"do": "press", "key": "Enter", "mods": ["mod"]},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "# Net heading\nUpdated instructions."},
            {"do": "field", "on": "skills.description", "equals": "Document description"},
            {"do": "click", "on": "skills.previewToggle"},
            {"do": "see", "on": "skills.preview", "text": "Net heading"},
            {"do": "gone", "on": "skills.preview", "text": "description:"},
            {"do": "click", "on": "skills.previewToggle"},
            {"do": "see", "on": "skills.line", "text": "Updated instructions."},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true, "timeout": 60},
            {"do": "field", "on": "skills.description", "equals": "Document description"},
            {"do": "see", "on": "skills.line", "text": "Updated instructions."}
          ]
        },
        {
          "id": "description-required",
          "kind": "break",
          "title": "An empty description refuses autosave and correcting it saves the document",
          "steps": [
            {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Original helper\n---\nOriginal instructions."},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "field", "on": "skills.description", "equals": "Original helper"},
            {"do": "click", "on": "skills.description", "clicks": 3},
            {"do": "press", "key": "Backspace"},
            {"do": "click", "on": "skills.editor"},
            {"do": "see", "on": "toast", "text": "Description is required"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "description: Original helper"},
            {"do": "click", "on": "skills.description"},
            {"do": "type", "text": "Corrected description"},
            {"do": "click", "on": "skills.editor"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "description: Corrected description"}
          ]
        },
        {
          "id": "write-failure",
          "kind": "break",
          "title": "A refused autosave retains the description and the next blur retries it",
          "steps": [
            {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Original helper\n---\nOriginal instructions."},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "field", "on": "skills.description", "equals": "Original helper"},
            {"do": "network.block", "urls": ["*/api/config/skills/net-helper*"]},
            {"do": "click", "on": "skills.description", "clicks": 3},
            {"do": "type", "text": "Retained description"},
            {"do": "click", "on": "skills.editor"},
            {"do": "see", "on": "toast", "text": "Failed to update skill"},
            {"do": "field", "on": "skills.description", "equals": "Retained description"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "Original helper"},
            {"do": "network.allow"},
            {"do": "click", "on": "skills.description"},
            {"do": "click", "on": "skills.editor"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "Retained description"}
          ]
        }
      ]
    },
    {
      "id": "use",
      "name": "Choosing when agents use a skill",
      "sources": ["packages/ui/src/components/sections/skills/SkillsPage.tsx", "packages/ui/src/components/sections/skills/SkillsSidebar.tsx", "packages/ui/src/components/sections/skills/SkillUseField.tsx"],
      "what": "Automatically, When called and Off preserve their distinct meaning; policy rules lock the choice and a failed change leaves the previous choice.",
      "reach": "An installed skill > Agents use it.",
      "proof": "When called writes the document flag; Off marks the sidebar without changing the document; reopening retains the choice; wildcard policies lock it and failed writes report an error.",
      "scenarios": [
        {
          "id": "choices",
          "kind": "path",
          "title": "When called persists, Off leaves the file intact, and Automatically restores automatic use",
          "steps": [
            {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Original helper\n---\nOriginal instructions."},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "see", "on": "skills.useOn", "text": "Automatically", "exact": true},
            {"do": "click", "on": "skills.use", "text": "When called", "exact": true},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "disable-model-invocation: true"},
            {"do": "click", "on": "skills.use", "text": "Off", "exact": true},
            {"do": "see", "on": "skills.row", "text": "Off"},
            {"do": "see", "on": "skills.useOn", "text": "Off", "exact": true},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "disable-model-invocation: true"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "skills.row", "text": "net-helper", "timeout": 60},
            {"do": "see", "on": "skills.useOn", "text": "Off", "exact": true},
            {"do": "click", "on": "skills.use", "text": "When called", "exact": true},
            {"do": "see", "on": "skills.useOn", "text": "When called", "exact": true},
            {"do": "see", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "click", "on": "skills.use", "text": "Automatically", "exact": true},
            {"do": "see", "on": "skills.useOn", "text": "Automatically", "exact": true},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true, "timeout": 60},
            {"do": "see", "on": "skills.useOn", "text": "Automatically", "exact": true}
          ]
        },
        {
          "id": "policy",
          "kind": "break",
          "title": "A wildcard deny marks the skill Blocked, names the rule and locks the choices",
          "steps": [
            {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Original helper\n---\nOriginal instructions."},
            {"do": "file.write", "path": "opencode.json", "content": "{\"policies\":[{\"action\":\"skill.use\",\"resource\":\"net-*\",\"effect\":\"deny\"}]}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "see", "on": "skills.row", "text": "Blocked"},
            {"do": "click", "on": "skills.row", "text": "net-helper"},
            {"do": "see", "on": "skills.useOn", "text": "Off", "exact": true},
            {"do": "see", "on": "skills.use", "count": 3, "disabled": true},
            {"do": "see", "on": "settings.row", "item": "skills.basic-information", "text": "net-*"},
            {"do": "file.expect", "path": ".opencode/skills/net-helper/SKILL.md", "contains": "Original instructions."}
          ]
        },
        {
          "id": "write-failure",
          "kind": "break",
          "title": "A refused Off write leaves automatic use selected and succeeds on retry",
          "steps": [
            {"do": "file.write", "path": ".opencode/skills/net-helper/SKILL.md", "content": "---\nname: net-helper\ndescription: Original helper\n---\nOriginal instructions."},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Skills", "exact": true, "timeout": 60},
            {"do": "click", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "see", "on": "skills.use", "text": "Off", "exact": true, "disabled": false},
            {"do": "network.block", "urls": ["*/api/config/skill-switch*"]},
            {"do": "click", "on": "skills.use", "text": "Off", "exact": true},
            {"do": "see", "on": "toast", "text": "Couldn't save the change to the OpenCode config."},
            {"do": "see", "on": "skills.useOn", "text": "Automatically", "exact": true},
            {"do": "see", "on": "skills.row", "text": "net-helper", "exact": true},
            {"do": "network.allow"},
            {"do": "click", "on": "skills.use", "text": "Off", "exact": true},
            {"do": "see", "on": "skills.useOn", "text": "Off", "exact": true},
            {"do": "see", "on": "skills.row", "text": "Off"}
          ]
        }
      ]
    },
    {
      "id": "files",
      "name": "Managing supporting files",
      "what": "New files require confirmation, existing file edits save when closed, and deletion asks first. Failed writes retain the dialog for retry.",
      "reach": "An installed skill > Supporting files.",
      "proof": "File content and existence on disk follow creation, editing and deletion; cancellation and failed requests preserve existing files.",

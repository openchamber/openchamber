{
  "zone": "projects",
  "name": "Project settings",
  "sources": ["packages/ui/src/components/sections/projects/ProjectsPage.tsx", "packages/ui/src/components/sections/projects/ProjectSettingsPanel.tsx"],
  "features": [
    {
      "id": "identity",
      "name": "Project identity",
      "sources": ["packages/ui/src/components/sections/projects/ProjectsPage.tsx", "packages/ui/src/components/sections/projects/ProjectsSidebar.tsx", "packages/ui/src/components/sections/projects/ProjectSettingsPanel.tsx", "packages/ui/src/components/sections/projects/ProjectSettingsHeader.tsx", "packages/ui/src/components/sections/projects/useProjectIdentityForm.ts", "packages/ui/src/components/sections/projects/useProjectIdentityAutoSave.ts"],
      "what": "Name, symbol and color save automatically; closing Settings accepts a pending name, while an empty name and unsupported image cannot replace the saved identity.",
      "reach": "Settings > Projects, then the name or the icon in the page header.",
      "proof": "Reopening and reloading retain the name and selected appearance; rejected input leaves the saved identity intact.",
      "scenarios": [
        {
          "id": "rename",
          "kind": "path",
          "title": "Closing Settings flushes the typed project name and reload keeps it",
          "steps": [
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Project name"},
            {"do":"click","on":"settings.searchResult","text":"Project name","exact":true},
            {"do":"click","on":"projects.name","clicks":3},
            {"do":"press","key":"Backspace"},
            {"do":"type","text":"Verify renamed project"},
            {"do":"click","on":"settings.close"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"field","on":"projects.name","equals":"Verify renamed project"},
            {"do":"click","on":"settings.close"},
            {"do":"reload"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"field","on":"projects.name","equals":"Verify renamed project"}
          ]
        },
        {
          "id": "blank",
          "kind": "break",
          "title": "A blank project name is not saved when Settings closes",
          "steps": [
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Project name"},
            {"do":"click","on":"settings.searchResult","text":"Project name","exact":true},
            {"do":"click","on":"projects.name","clicks":3},
            {"do":"press","key":"Backspace"},
            {"do":"type","text":"   "},
            {"do":"click","on":"settings.close"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"field","on":"projects.name","equals":"relay-desk"}
          ]
        },
        {
          "id": "appearance",
          "kind": "path",
          "title": "A chosen symbol and color remain selected after reopening Settings",
          "steps": [
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Project name"},
            {"do":"click","on":"settings.searchResult","text":"Project name","exact":true},
            {"do":"click","on":"projects.appearance"},
            {"do":"click","on":"projects.appearanceChoice","label":"Code"},
            {"do":"click","on":"projects.appearanceChoice","label":"Color #e5484d"},
            {"do":"pause","ms":1500},
            {"do":"press","key":"Escape"},
            {"do":"click","on":"settings.close"},
            {"do":"reload"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"projects.appearance"},
            {"do":"see","on":"projects.appearanceSelected","label":"Code"},
            {"do":"see","on":"projects.appearanceSelected","label":"Color #e5484d"}
          ]
        },
        {
          "id": "invalid-image",
          "kind": "break",
          "title": "An unsupported image reports its format and leaves Upload icon available",
          "steps": [
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Project name"},
            {"do":"click","on":"settings.searchResult","text":"Project name","exact":true},
            {"do":"click","on":"projects.appearance"},
            {"do":"click","on":"projects.button","text":"Image","exact":true},
            {"do":"chooseFiles","files":[{"name":"invalid.txt","content":"not an image"}]},
            {"do":"click","on":"projects.button","text":"Upload icon","exact":true},
            {"do":"see","on":"toast.error","text":"Only PNG, JPEG, and SVG are supported"},
            {"do":"click","on":"projects.appearance"},
            {"do":"click","on":"projects.button","text":"Image","exact":true},
            {"do":"see","on":"projects.button","text":"Upload icon","exact":true},
            {"do":"gone","on":"projects.button","text":"Remove project icon","exact":true}
          ]
        }
      ]
    },
    {
      "id": "general",
      "name": "Defaults and team configuration",
      "sources": ["packages/ui/src/components/sections/projects/ProjectsPage.tsx", "packages/ui/src/components/sections/projects/ProjectSettingsPanel.tsx", "packages/ui/src/components/sections/projects/ProjectGeneralTab.tsx", "packages/ui/src/components/sections/projects/projectSettingsTabs.ts", "packages/ui/src/components/sections/projects/useProjectIdentityForm.ts", "packages/ui/src/components/sections/projects/useProjectIdentityAutoSave.ts", "packages/ui/src/components/sections/projects/useProjectSetup.ts", "packages/ui/src/components/sections/projects/ProjectSettingsBits.tsx"],
      "what": "A project supplies defaults for new chats, a team plans folder and a personal notes location. Unreadable setup offers retry; malformed team files cannot be overwritten.",
      "reach": "Settings search > Project agent or Plans folder, on General.",
      "proof": "The new chat uses the picked agent; the plans folder reaches the repository file; read failures recover and an invalid file stays untouched.",
      "scenarios": [
        {
          "id":"agent",
          "kind":"path",
          "title":"The project agent persists and starts the next new chat on Plan",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Project agent"},
            {"do":"click","on":"settings.searchResult","text":"Project agent","exact":true},
            {"do":"click","on":"settings.menu","item":"projects.default-agent"},
            {"do":"click","on":"menu.item","text":"Plan","exact":true},
            {"do":"see","on":"settings.menu","item":"projects.default-agent","text":"plan"},
            {"do":"pause","ms":1500},
            {"do":"click","on":"settings.close"},
            {"do":"reload"},
            {"do":"click","on":"sidebar.newSession"},
            {"do":"click","on":"composer.projectPicker","text":"Choose project"},
            {"do":"click","on":"composer.projectOption","text":"relay-desk"},
            {"do":"see","on":"composer.control","text":"Plan","exact":true}
          ]
        },
        {
          "id":"plans-notes",
          "kind":"path",
          "title":"Enter saves a trimmed plans folder and the notes location checkbox persists",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Plans folder"},
            {"do":"click","on":"settings.searchResult","text":"Plans folder"},
            {"do":"click","on":"projects.field","label":"Repository plans folder"},
            {"do":"type","text":"  docs/plans  "},
            {"do":"press","key":"Enter"},
            {"do":"file.expect","path":".openchamber/project.json","contains":"\"plansDir\": \"docs/plans\""},
            {"do":"click","on":"settings.checkboxOff","item":"projects.notes-todos.repository"},
            {"do":"see","on":"settings.checkboxOn","item":"projects.notes-todos.repository"},
            {"do":"click","on":"settings.close"},
            {"do":"reload"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"field","on":"projects.field","label":"Repository plans folder","equals":"docs/plans"},
            {"do":"see","on":"settings.checkboxOn","item":"projects.notes-todos.repository"},
            {"do":"click","on":"settings.checkboxOn","item":"projects.notes-todos.repository"},
            {"do":"see","on":"settings.checkboxOff","item":"projects.notes-todos.repository"}
          ]
        },
        {
          "id":"invalid-team",
          "kind":"break",
          "title":"An invalid team file disables plans edits and Team action creation without overwriting it",
          "steps":[
            {"do":"file.write","path":".openchamber/project.json","content":"{ broken team setup"},
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Plans folder"},
            {"do":"click","on":"settings.searchResult","text":"Plans folder"},
            {"do":"see","on":"projects.section","item":"projects.shared","text":"could not be read"},
            {"do":"see","on":"projects.field","label":"Repository plans folder","disabled":true},
            {"do":"click","on":"projects.tab","text":"Actions","exact":true},
            {"do":"click","on":"projects.button","text":"New action","exact":true},
            {"do":"see","on":"projects.editorButton","text":"Team","exact":true,"disabled":true},
            {"do":"file.expect","path":".openchamber/project.json","equals":"{ broken team setup"}
          ]
        },
        {
          "id":"read-retry",
          "kind":"break",
          "title":"A failed setup read hides editing until Try again succeeds",
          "steps":[
            {"do":"network.block","urls":["*/api/projects/*/config*"]},
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Plans folder"},
            {"do":"click","on":"settings.searchResult","text":"Plans folder"},
            {"do":"see","on":"projects.section","item":"projects.shared","text":"Couldn't read this project's setup"},
            {"do":"gone","on":"projects.field","label":"Repository plans folder"},
            {"do":"network.allow"},
            {"do":"click","on":"projects.button","text":"Try again","exact":true},
            {"do":"see","on":"projects.field","label":"Repository plans folder","disabled":false}
          ]
        }
      ]
    },
    {
      "id":"actions",
      "name":"Editing project actions",
      "sources":["packages/ui/src/components/sections/projects/ProjectSettingsPanel.tsx","packages/ui/src/components/sections/projects/ProjectActionsTab.tsx","packages/ui/src/components/sections/projects/ProjectActionEditorDialog.tsx","packages/ui/src/components/sections/projects/projectSetupModel.ts","packages/ui/src/components/sections/projects/useProjectSetup.ts"],
      "what":"Action drafts validate required fields, save to personal or team files, move between them and can be hidden or deleted. Failed writes report an error and a failed reread offers retry.",
      "reach":"Settings search > Actions > New action or an existing action row.",
      "proof":"Reopened fields preserve the saved options; team edits reach disk, hiding keeps the team file intact, and the setup rereads after a failed write.",
      "scenarios":[
        {
          "id":"draft",
          "kind":"break",
          "title":"Name and command are required; Cancel discards a complete action draft",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Actions"},
            {"do":"click","on":"settings.searchResult","text":"Commands the run button starts"},
            {"do":"click","on":"projects.button","text":"New action","exact":true},
            {"do":"see","on":"projects.editorButton","text":"Save","exact":true,"disabled":true},
            {"do":"type","text":"Draft action"},
            {"do":"see","on":"projects.editorButton","text":"Save","exact":true,"disabled":true},
            {"do":"click","on":"projects.field","label":"Command"},
            {"do":"type","text":"echo draft"},
            {"do":"see","on":"projects.editorButton","text":"Save","exact":true,"disabled":false},
            {"do":"click","on":"projects.editorButton","text":"Cancel","exact":true},
            {"do":"gone","on":"projects.editor"},
            {"do":"gone","on":"projects.action","text":"Draft action"},
            {"do":"file.expect","path":".openchamber/project.json","exists":false},
            {"do":"click","on":"projects.button","text":"New action","exact":true},
            {"do":"field","on":"projects.field","label":"Action name","equals":""},
            {"do":"field","on":"projects.field","label":"Command","equals":""}
          ]
        },
        {
          "id":"roundtrip",
          "kind":"path",
          "title":"An action keeps run directory, platform and URL options, then moves to the team file and back",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Actions"},
            {"do":"click","on":"settings.searchResult","text":"Commands the run button starts"},
            {"do":"click","on":"projects.button","text":"New action","exact":true},
            {"do":"type","text":"Verify action"},
            {"do":"click","on":"projects.field","label":"Command"},
            {"do":"type","text":"echo verify"},
            {"do":"click","on":"projects.editorButton","text":"Parent checkout","exact":true},
            {"do":"click","on":"projects.editorButton","text":"macOS","exact":true},
            {"do":"click","on":"projects.openUrl"},
            {"do":"click","on":"projects.field","label":"Override URL (optional)"},
            {"do":"type","text":"http://localhost:3210"},
            {"do":"click","on":"projects.editorButton","text":"Save","exact":true},
            {"do":"gone","on":"projects.editor"},
            {"do":"click","on":"projects.action","text":"Verify action"},
            {"do":"see","on":"projects.actionChip","label":"Working directory for this action","pressed":"true","text":"Parent checkout"},
            {"do":"see","on":"projects.actionChip","label":"Platforms","pressed":"true","text":"macOS"},
            {"do":"field","on":"projects.field","label":"Override URL (optional)","equals":"http://localhost:3210"},
            {"do":"click","on":"projects.editorButton","text":"Team","exact":true},
            {"do":"click","on":"projects.editorButton","text":"Save","exact":true},
            {"do":"gone","on":"projects.editor"},
            {"do":"file.expect","path":".openchamber/project.json","contains":"\"runIn\": \"parent\""},
            {"do":"see","on":"projects.action","text":"Verify action","count":1},
            {"do":"click","on":"projects.action","text":"Verify action"},
            {"do":"click","on":"projects.editorButton","text":"Only me","exact":true},
            {"do":"click","on":"projects.editorButton","text":"Save","exact":true},
            {"do":"gone","on":"projects.editor"},
            {"do":"see","on":"projects.action","text":"Only me","count":1},
            {"do":"file.expect","path":".openchamber/project.json","exists":false},
            {"do":"click","on":"projects.action","text":"Verify action"},
            {"do":"click","on":"projects.editorButton","text":"Delete","exact":true},
            {"do":"gone","on":"projects.action","text":"Verify action"}
          ]
        },
        {
          "id":"hide-delete",
          "kind":"path",
          "title":"A team action hides and shows personally; deletion asks and Cancel preserves it",
          "steps":[
            {"do":"file.write","path":".openchamber/project.json","content":"{\"version\":1,\"projectActions\":[{\"id\":\"team-check\",\"name\":\"Team check\",\"command\":\"echo team\"}]}"},
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Actions"},
            {"do":"click","on":"settings.searchResult","text":"Commands the run button starts"},
            {"do":"click","on":"projects.action","text":"Team check","button":"right"},
            {"do":"click","on":"menu.item","text":"Hide for me","exact":true},
            {"do":"see","on":"projects.action","text":"Hidden for you"},
            {"do":"file.expect","path":".openchamber/project.json","contains":"Team check"},
            {"do":"click","on":"projects.action","text":"Team check","button":"right"},
            {"do":"click","on":"menu.item","text":"Show for me","exact":true},
            {"do":"gone","on":"projects.action","text":"Hidden for you"},
            {"do":"click","on":"projects.action","text":"Team check","button":"right"},
            {"do":"click","on":"menu.item","text":"Delete for everyone","exact":true},
            {"do":"see","on":"dialog","text":"Delete \"Team check\" for everyone?"},
            {"do":"click","on":"dialog.button","text":"Cancel","exact":true},
            {"do":"see","on":"projects.action","text":"Team check"},
            {"do":"click","on":"projects.action","text":"Team check","button":"right"},
            {"do":"click","on":"menu.item","text":"Delete for everyone","exact":true},
            {"do":"click","on":"dialog.button","text":"Delete","exact":true},
            {"do":"gone","on":"projects.action","text":"Team check"},
            {"do":"file.expect","path":".openchamber/project.json","exists":false}
          ]
        },
        {
          "id":"save-retry",
          "kind":"break",
          "title":"A refused action write reports failure and setup can be reread before creating again",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Actions"},
            {"do":"click","on":"settings.searchResult","text":"Commands the run button starts"},
            {"do":"click","on":"projects.button","text":"New action","exact":true},
            {"do":"type","text":"Retry action"},
            {"do":"click","on":"projects.field","label":"Command"},
            {"do":"type","text":"echo retry"},
            {"do":"network.block","urls":["*/api/projects/*/config*"]},
            {"do":"click","on":"projects.editorButton","text":"Save","exact":true},
            {"do":"see","on":"toast.error","text":"Failed to save actions"},
            {"do":"see","on":"projects.section","item":"projects.actions","text":"Couldn't read this project's setup"},
            {"do":"network.allow"},
            {"do":"click","on":"projects.button","text":"Try again","exact":true},
            {"do":"click","on":"projects.button","text":"New action","exact":true},
            {"do":"type","text":"Retry action"},
            {"do":"click","on":"projects.field","label":"Command"},
            {"do":"type","text":"echo retry"},
            {"do":"click","on":"projects.editorButton","text":"Save","exact":true},
            {"do":"gone","on":"projects.editor"},
            {"do":"see","on":"projects.action","text":"Retry action"},
            {"do":"click","on":"projects.action","text":"Retry action"},
            {"do":"click","on":"projects.editorButton","text":"Delete","exact":true},
            {"do":"gone","on":"projects.action","text":"Retry action"}
          ]
        }
      ]
    },
    {
      "id":"worktrees",
      "name":"Worktree commands",
      "sources":["packages/ui/src/components/sections/projects/ProjectsPage.tsx","packages/ui/src/components/sections/projects/ProjectSettingsPanel.tsx","packages/ui/src/components/sections/projects/ProjectWorktreesTab.tsx","packages/ui/src/components/sections/projects/projectSetupModel.ts","packages/ui/src/components/sections/projects/useProjectSetup.ts"],
      "what":"Setup and teardown commands can be added, edited, removed and moved between team and personal storage. Personal setup can skip the team's commands, and creation and wait choices persist.",
      "reach":"Settings search > Setup commands, then Worktrees.",
      "proof":"Reopened fields and the team file reflect the edits; Skipped for you follows replace mode; refused writes report an error.",
      "scenarios":[
        {
          "id":"commands",
          "kind":"path",
          "title":"Setup and teardown commands add on Enter, edit on blur and remove from their menus",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Setup commands"},
            {"do":"click","on":"settings.searchResult","text":"Wait for setup commands"},
            {"do":"click","on":"projects.commandAdd","item":"projects.worktree"},
            {"do":"type","text":"echo setup"},
            {"do":"press","key":"Enter"},
            {"do":"field","on":"projects.field","label":"Setup command 1","equals":"echo setup"},
            {"do":"click","on":"projects.field","label":"Setup command 1","clicks":3},
            {"do":"press","key":"Backspace"},
            {"do":"type","text":"echo edited"},
            {"do":"press","key":"Tab"},
            {"do":"field","on":"projects.field","label":"Setup command 1","equals":"echo edited"},
            {"do":"click","on":"projects.commandAdd","item":"projects.worktree.teardown"},
            {"do":"type","text":"echo teardown"},
            {"do":"press","key":"Enter"},
            {"do":"field","on":"projects.field","label":"Teardown command 1","equals":"echo teardown"},
            {"do":"click","on":"settings.close"},
            {"do":"reload"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"projects.tab","text":"Worktrees","exact":true},
            {"do":"field","on":"projects.field","label":"Setup command 1","equals":"echo edited"},
            {"do":"field","on":"projects.field","label":"Teardown command 1","equals":"echo teardown"},
            {"do":"click","on":"projects.commandMenu","item":"projects.worktree"},
            {"do":"click","on":"menu.item","text":"Remove command","exact":true},
            {"do":"gone","on":"projects.field","label":"Setup command 1"},
            {"do":"click","on":"projects.commandMenu","item":"projects.worktree.teardown"},
            {"do":"click","on":"menu.item","text":"Remove command","exact":true},
            {"do":"gone","on":"projects.field","label":"Teardown command 1"}
          ]
        },
        {
          "id":"scope-replace",
          "kind":"path",
          "title":"A personal setup command moves to the repository, can be skipped, then moves back",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Setup commands"},
            {"do":"click","on":"settings.searchResult","text":"Wait for setup commands"},
            {"do":"click","on":"projects.commandAdd","item":"projects.worktree"},
            {"do":"type","text":"echo shared"},
            {"do":"press","key":"Enter"},
            {"do":"field","on":"projects.field","label":"Setup command 1","equals":"echo shared"},
            {"do":"click","on":"projects.commandMenu","item":"projects.worktree"},
            {"do":"click","on":"menu.item","text":"Move to repository","exact":true},
            {"do":"file.expect","path":".openchamber/project.json","contains":"echo shared"},
            {"do":"click","on":"settings.checkboxOff","item":"projects.worktree.setup.replace"},
            {"do":"see","on":"projects.section","item":"projects.worktree","text":"Skipped for you"},
            {"do":"click","on":"settings.checkboxOn","item":"projects.worktree.setup.replace"},
            {"do":"gone","on":"projects.section","item":"projects.worktree","text":"Skipped for you"},
            {"do":"click","on":"projects.commandMenu","item":"projects.worktree"},
            {"do":"click","on":"menu.item","text":"Move to my settings","exact":true},
            {"do":"file.expect","path":".openchamber/project.json","exists":false},
            {"do":"field","on":"projects.field","label":"Setup command 1","equals":"echo shared"},
            {"do":"see","on":"projects.section","item":"projects.worktree","text":"Only me"},
            {"do":"click","on":"projects.commandMenu","item":"projects.worktree"},
            {"do":"click","on":"menu.item","text":"Remove command","exact":true},
            {"do":"gone","on":"projects.field","label":"Setup command 1"}
          ]
        },
        {
          "id":"create-wait",
          "kind":"path",
          "title":"A custom creation command and Wait choice persist; clearing the command restores Git",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Setup commands"},
            {"do":"click","on":"settings.searchResult","text":"Wait for setup commands"},
            {"do":"click","on":"projects.field","label":"Worktree create command"},
            {"do":"type","text":"echo custom-create"},
            {"do":"press","key":"Enter"},
            {"do":"click","on":"settings.checkboxOff","item":"projects.worktree.setup.wait"},
            {"do":"see","on":"settings.checkboxOn","item":"projects.worktree.setup.wait"},
            {"do":"click","on":"settings.close"},
            {"do":"reload"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"projects.tab","text":"Worktrees","exact":true},
            {"do":"field","on":"projects.field","label":"Worktree create command","equals":"echo custom-create"},
            {"do":"see","on":"settings.checkboxOn","item":"projects.worktree.setup.wait"},
            {"do":"click","on":"projects.field","label":"Worktree create command","clicks":3},
            {"do":"press","key":"Backspace"},
            {"do":"press","key":"Enter"},
            {"do":"click","on":"projects.tab","text":"General","exact":true},
            {"do":"click","on":"projects.tab","text":"Worktrees","exact":true},
            {"do":"field","on":"projects.field","label":"Worktree create command","equals":""},
            {"do":"click","on":"settings.checkboxOn","item":"projects.worktree.setup.wait"},
            {"do":"see","on":"settings.checkboxOff","item":"projects.worktree.setup.wait"}
          ]
        },
        {
          "id":"write-failure",
          "kind":"break",
          "title":"A refused setup command save reports failure and a fresh read restores the stored command",
          "steps":[
            {"do":"file.write","path":".openchamber/project.json","content":"{\"version\":1,\"setupWorktree\":[\"echo original\"]}"},
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},
            {"do":"click","on":"settings.search","timeout":60},
            {"do":"type","text":"Setup commands"},
            {"do":"click","on":"settings.searchResult","text":"Wait for setup commands"},
            {"do":"click","on":"projects.field","label":"Setup command 1","clicks":3},
            {"do":"press","key":"Backspace"},
            {"do":"type","text":"echo refused"},
            {"do":"network.block","urls":["*/api/projects/*/config*"]},
            {"do":"press","key":"Enter"},
            {"do":"see","on":"toast.error","text":"Failed to save worktree setup commands"},
            {"do":"network.allow"},
            {"do":"click","on":"projects.button","text":"Try again","exact":true},
            {"do":"field","on":"projects.field","label":"Setup command 1","equals":"echo original"},
            {"do":"file.expect","path":".openchamber/project.json","equals":"{\"version\":1,\"setupWorktree\":[\"echo original\"]}"}
          ]
        }
      ]
    },
    {
      "id":"environment",
      "name":"Project environment",
      "sources":["packages/ui/src/components/sections/projects/ProjectSettingsPanel.tsx","packages/ui/src/components/sections/projects/ProjectEnvironmentSection.tsx"],
      "what":"Variables are saved by name with masked values. An environment command can be saved and rerun; failed reads, writes and commands are visible.",
      "reach":"Settings search > Project environment, on Environment.",
      "proof":"Names survive reopening, removal removes them, command status reports applied variables or the failure, and a failed save retains its draft.",
      "scenarios":[
        {
          "id":"variables",
          "kind":"path",
          "title":"Variables add with masked values, reopen without revealing values, replace and remove",
          "steps":[
            {"do":"open"},
            {"do":"click","on":"sidebar.settings"},

{
  "zone": "agents",
  "name": "Agent settings",
  "sources": ["packages/ui/src/components/sections/agents/AgentsPage.tsx", "packages/ui/src/components/sections/agents/AgentsSidebar.tsx"],
  "features": [{
    "id": "create",
    "name": "Creating an agent",
    "what": "A new agent starts as an unwritten draft and is created in the chosen scope.",
    "reach": "Settings > Agents > +.",
    "proof": "Create writes the named agent and opens its editable settings; Cancel leaves no file.",
    "scenarios": [{
      "id": "project",
      "kind": "path",
      "title": "Create normalizes the name and writes the description and prompt in the project",
      "steps": [
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "click", "on": "agents.create"},
        {"do": "click", "on": "agents.name", "clicks": 3},
        {"do": "type", "text": "net helper"},
        {"do": "click", "on": "agents.scope"},
        {"do": "click", "on": "agents.option", "text": "Project", "exact": true},
        {"do": "click", "on": "agents.description"},
        {"do": "type", "text": "Reviews local changes"},
        {"do": "click", "on": "agents.field", "field": "system-prompt"},
        {"do": "type", "text": "Read before editing."},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "exists": false},
        {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Reviews local changes"},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Read before editing."},
        {"do": "see", "on": "agents.row", "text": "net-helper"},
        {"do": "gone", "on": "agents.name"}
      ]
    }, {
      "id": "cancel",
      "kind": "break",
      "title": "A blank name disables Create and Cancel discards the unwritten draft",
      "steps": [
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "click", "on": "agents.create"},
        {"do": "click", "on": "agents.name", "clicks": 3},
        {"do": "press", "key": "Backspace"},
        {"do": "see", "on": "dialog.button", "text": "Create", "exact": true, "disabled": true},
        {"do": "type", "text": "net-cancelled"},
        {"do": "click", "on": "agents.scope"},
        {"do": "click", "on": "agents.option", "text": "Project", "exact": true},
        {"do": "click", "on": "dialog.button", "text": "Cancel", "exact": true},
        {"do": "gone", "on": "agents.name"},
        {"do": "see", "on": "agents.row", "text": "net-cancelled", "count": 0},
        {"do": "file.expect", "path": ".opencode/agents/net-cancelled.md", "exists": false}
      ]
    }, {
      "id": "taken",
      "kind": "break",
      "title": "Creating with an existing agent name refuses it and keeps the draft",
      "steps": [
        {"do": "file.write", "path": ".opencode/agents/net-helper.md", "content": ["---", "description: Original helper", "mode: subagent", "---", "Original prompt."]},
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "see", "on": "agents.row", "text": "net-helper"},
        {"do": "click", "on": "agents.create"},
        {"do": "click", "on": "agents.name", "clicks": 3},
        {"do": "type", "text": "net-helper"},
        {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
        {"do": "see", "on": "toast", "text": "An agent with this name already exists"},
        {"do": "see", "on": "agents.name"},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Original prompt."}
      ]
    }, {
      "id": "write-failure",
      "kind": "break",
      "title": "A failed Create keeps the project draft and can be retried after the connection recovers",
      "steps": [
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "click", "on": "agents.create"},
        {"do": "click", "on": "agents.name", "clicks": 3},
        {"do": "type", "text": "net-retry"},
        {"do": "click", "on": "agents.scope"},
        {"do": "click", "on": "agents.option", "text": "Project", "exact": true},
        {"do": "network.block", "urls": ["*/api/config/agents/net-retry*"]},
        {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
        {"do": "see", "on": "toast", "text": "Failed to create agent"},
        {"do": "field", "on": "agents.name", "equals": "net-retry"},
        {"do": "file.expect", "path": ".opencode/agents/net-retry.md", "exists": false},
        {"do": "network.allow"},
        {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
        {"do": "file.expect", "path": ".opencode/agents/net-retry.md", "exists": true},
        {"do": "see", "on": "agents.row", "text": "net-retry"},
        {"do": "gone", "on": "agents.name"}
      ]
    }]
  }, {
    "id": "edit",
    "name": "Editing stored agent settings",
    "sources": ["packages/ui/src/components/sections/agents/AgentsPage.tsx", "packages/ui/src/components/sections/agents/AgentsSidebar.tsx"],
    "what": "Existing text saves on blur, mode saves on selection, and a failed write leaves the edit available for retry.",
    "reach": "Settings > Agents > a custom agent.",
    "proof": "The file holds the edits and reopening the agent reads them; a refused write reports an error and can be retried.",
    "scenarios": [{
      "id": "autosave",
      "kind": "path",
      "title": "Description, prompt and mode save and survive switching to another agent",
      "steps": [
        {"do": "file.write", "path": ".opencode/agents/net-helper.md", "content": ["---", "description: Original helper", "mode: subagent", "---", "Original prompt."]},
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "click", "on": "agents.row", "text": "net-helper"},
        {"do": "click", "on": "agents.description", "clicks": 3},
        {"do": "type", "text": "Updated helper"},
        {"do": "click", "on": "agents.field", "field": "system-prompt", "clicks": 3},
        {"do": "type", "text": "Updated prompt."},
        {"do": "click", "on": "settings.chip", "item": "agents.mode", "text": "All", "exact": true},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Updated helper"},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Updated prompt."},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "mode: all"},
        {"do": "click", "on": "agents.row", "text": "build"},
        {"do": "click", "on": "agents.row", "text": "net-helper"},
        {"do": "field", "on": "agents.field", "field": "system-prompt", "equals": "Updated prompt."},
        {"do": "see", "on": "settings.chipOn", "item": "agents.mode", "text": "All", "exact": true}
      ]
    }, {
      "id": "write-failure",
      "kind": "break",
      "title": "A failed autosave reports the error, keeps the draft and saves on the next blur after recovery",
      "steps": [
        {"do": "file.write", "path": ".opencode/agents/net-helper.md", "content": ["---", "description: Original helper", "mode: subagent", "---", "Original prompt."]},
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "click", "on": "agents.row", "text": "net-helper"},
        {"do": "field", "on": "agents.field", "field": "system-prompt", "equals": "Original prompt."},
        {"do": "see", "on": "agents.permissionOn", "label": "Permission for shell", "text": "Inherit", "exact": true},
        {"do": "network.block", "urls": ["*/api/config/agents/net-helper*"]},
        {"do": "click", "on": "agents.field", "field": "system-prompt", "clicks": 3},
        {"do": "type", "text": "Retry this prompt."},
        {"do": "click", "on": "agents.description"},
        {"do": "see", "on": "toast", "text": "Failed to fetch"},
        {"do": "field", "on": "agents.field", "field": "system-prompt", "equals": "Retry this prompt."},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Original prompt."},
        {"do": "network.allow"},
        {"do": "click", "on": "agents.field", "field": "system-prompt"},
        {"do": "click", "on": "agents.description"},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Retry this prompt."}
      ]
    }]
  }, {
    "id": "model",
    "name": "Model overrides",
    "sources": ["packages/ui/src/components/sections/agents/AgentsPage.tsx", "packages/ui/src/components/sections/agents/AgentsSidebar.tsx", "packages/ui/src/components/sections/agents/ModelSelector.tsx"],
    "what": "A model override and its variant save on the agent; clearing the model restores inheritance and clears the variant.",
    "reach": "Settings > Agents > a custom agent > Override model.",
    "proof": "The selected model and variant reach the file; Not selected removes both; an unmatched search shows no results and Escape closes it.",
    "scenarios": [{
      "id": "override-clear",
      "kind": "path",
      "title": "A model and thinking variant save, then Not selected clears both",
      "steps": [
        {"do": "file.write", "path": ".opencode/agents/net-helper.md", "content": ["---", "description: Original helper", "mode: subagent", "---", "Original prompt."]},
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "click", "on": "agents.row", "text": "net-helper"},
        {"do": "see", "on": "agents.field", "field": "variant", "disabled": true},
        {"do": "click", "on": "settings.menu", "item": "agents.model"},
        {"do": "click", "on": "picker.search"},
        {"do": "type", "text": "code, seeding"},
        {"do": "click", "on": "picker.option", "text": "Fixture code, seeding speed"},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "perf/code-20000cps"},
        {"do": "click", "on": "agents.variant"},
        {"do": "click", "on": "agents.option", "text": "high", "exact": true},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "perf/code-20000cps#high"},
        {"do": "click", "on": "settings.menu", "item": "agents.model"},
        {"do": "click", "on": "agents.noModel", "text": "Not selected"},
        {"do": "see", "on": "settings.menu", "item": "agents.model", "text": "Not selected"},
        {"do": "see", "on": "agents.value", "field": "variant", "value": "", "disabled": true},
        {"do": "click", "on": "agents.row", "text": "build"},
        {"do": "click", "on": "agents.row", "text": "net-helper"},
        {"do": "see", "on": "settings.menu", "item": "agents.model", "text": "Not selected"},
        {"do": "see", "on": "agents.value", "field": "variant", "value": "", "disabled": true}
      ]
    }, {
      "id": "no-match",
      "kind": "break",
      "title": "An unmatched model search says so and Escape leaves the override unchanged",
      "steps": [
        {"do": "file.write", "path": ".opencode/agents/net-helper.md", "content": ["---", "description: Original helper", "mode: subagent", "model: perf/code-20000cps", "---", "Original prompt."]},
        {"do": "open"},
        {"do": "click", "on": "sidebar.settings"},
        {"do": "click", "on": "dialog.button", "text": "Agents", "exact": true, "timeout": 60},
        {"do": "click", "on": "agents.row", "text": "net-helper"},
        {"do": "see", "on": "settings.menu", "item": "agents.model", "text": "Fixture code, seeding speed"},
        {"do": "click", "on": "settings.menu", "item": "agents.model"},
        {"do": "click", "on": "picker.search"},
        {"do": "type", "text": "no-such-fixture-model"},
        {"do": "see", "on": "dialog", "text": "No models found"},
        {"do": "press", "key": "Escape"},
        {"do": "gone", "on": "picker.search"},
        {"do": "see", "on": "settings.menu", "item": "agents.model", "text": "Fixture code, seeding speed"},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "model: perf/code-20000cps"}
      ]
    }]
  }, {
    "id": "manage",
    "name": "Managing custom agents",
    "sources": ["packages/ui/src/components/sections/agents/AgentsSidebar.tsx", "packages/ui/src/components/sections/agents/AgentsPage.tsx"],
    "what": "The row menu duplicates, renames, deletes and disables an agent without losing its stored settings.",
    "reach": "Settings > Agents > right-click a custom agent.",
    "proof": "Files and sidebar rows follow each operation; Cancel preserves the agent; Enable restores a disabled row.",
    "scenarios": [{
      "id": "duplicate",
      "kind": "path",
      "title": "Duplicate prefills a project draft with the stored prompt, model and permissions and creates a separate copy",
      "steps": [
        {"do": "file.write", "path": ".opencode/agents/net-helper.md", "content": ["---", "description: Original helper", "mode: subagent", "model: perf/code-20000cps", "permissions:", "  - action: shell", "    resource: '*'", "    effect: deny", "---", "Original prompt."]},

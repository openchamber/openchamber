        {"do": "file.expect", "path": ".opencode/agents/net-helper-copy.md", "contains": "effect: deny"},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "contains": "Original prompt."},
        {"do": "see", "on": "agents.row", "text": "net-helper-copy"},
        {"do": "see", "on": "agents.permissionOn", "label": "Permission for shell", "text": "Deny", "exact": true}

  }, {
    "id": "permissions",
    "name": "Agent tool permissions",
    "sources": ["packages/ui/src/components/sections/agents/AgentsPage.tsx", "packages/ui/src/components/sections/agents/AgentsSidebar.tsx", "packages/ui/src/components/sections/agents/AgentPermissionsEditor.tsx", "packages/ui/src/components/sections/agents/agentPermissionModel.ts"],
    "what": "Agent-wide, per-tool and resource rules save without changing unrelated rules; a failed read offers Retry.",
    "reach": "Settings > Agents > a custom agent > Tool permissions.",
    "proof": "Choices and resource patterns survive reopening; files keep unrelated rules; Retry replaces the error with the editor.",
    "scenarios": [{
      "id": "effects",
      "kind": "path",
      "title": "An agent default and a tool override save, and Inherit removes only the tool override",
      "steps": [
        {"do": "file.write", "path": ".opencode/agents/net-helper.md", "content": ["---", "description: Original helper", "mode: subagent", "---", "Original prompt."]},
        {"do": "open"},

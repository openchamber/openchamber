        {"do": "click", "on": "agents.row", "text": "net-helper", "button": "right"},
        {"do": "click", "on": "menu.item", "text": "Delete", "exact": true},
        {"do": "click", "on": "dialog.button", "text": "Delete", "exact": true},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "exists": false},
        {"do": "gone", "on": "agents.row", "text": "net-helper"}

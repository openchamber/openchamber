        {"do": "file.expect", "path": ".opencode/agents/net-renamed.md", "contains": "Original prompt."},
        {"do": "file.expect", "path": ".opencode/agents/net-helper.md", "exists": false},
        {"do": "see", "on": "agents.row", "text": "net-renamed"},
        {"do": "see", "on": "agents.row", "text": "net-helper", "count": 0},
        {"do": "field", "on": "agents.field", "field": "system-prompt", "equals": "Original prompt."}
      ]
    }, {
      "id": "delete",
      "kind": "path",
      "title": "Delete asks first, Cancel keeps the file, and confirming removes it and its row",

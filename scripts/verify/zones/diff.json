{
  "zone": "diff",
  "name": "Changes and diffs",
  "sources": ["packages/ui/src/components/views/DiffView.tsx", "packages/ui/src/components/views/PierreDiffViewer.tsx", "packages/ui/src/components/views/pierreDiff/", "packages/ui/src/components/views/diffFileTree.ts"],
  "features": [
    {
      "id": "changes",
      "name": "The Changes panel",
      "sources": ["packages/ui/src/components/views/DiffView.tsx", "packages/ui/src/components/views/ChangeScopeSelector.tsx"],
      "what": "Changes lists the project's uncommitted files with their added and removed line counts; a file opens to its diff. The list refreshes after the agent's edits, after a save in the editor and each time the panel is shown.",
      "reach": "Click Changes on the right rail of a session.",
      "proof": "The changed file is listed with its counts, its diff shows the added and removed lines, a clean project says so, a save or an outside change shows up at the moments above.",
      "scenarios": [
        {
          "id": "agent-edit",
          "kind": "path",
          "title": "The file the agent edited is listed with +12 −2 and opens to its diff",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff agent edit"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "see", "on": "diff.mode", "text": "Changed: 1"},
            {"do": "see", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.file", "text": "+12"},
            {"do": "see", "on": "diff.file", "text": "−2"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.added", "count": 12},
            {"do": "see", "on": "diff.removed", "count": 2},
            {"do": "see", "on": "diff.added", "text": "const isAbortError = (error: unknown)"},
            {"do": "see", "on": "diff.removed", "text": "await sleep(options.baseDelayMs * 2 ** attempt)"},
            {"do": "screenshot", "name": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "gone", "on": "diff.added"}
          ]
        },
        {
          "id": "clean",
          "kind": "break",
          "title": "A project without changes says the working tree is clean",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff clean"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "see", "on": "panel", "text": "Working tree clean"},
            {"do": "see", "on": "diff.mode", "text": "Changed: 0"},
            {"do": "see", "on": "diff.added", "count": 0, "timeout": 1}
          ]
        },
        {
          "id": "outside-change",
          "kind": "break",
          "title": "Files changed and added outside the app show once the panel is opened again",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff outside change"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "see", "on": "panel", "text": "Working tree clean"},
            {"do": "file.write", "path": "src/api/client.ts", "content": ["import { withRetry } from \"./retry\"", "", "export const rewrittenOutside = true", ""]},
            {"do": "file.write", "path": "src/new-module.ts", "content": ["export const added = 1", ""]},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "gone", "on": "panel.surfaceOn", "surface": "diff"},
            {"do": "pause", "ms": 1500},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "see", "on": "diff.file", "text": "client.ts"},
            {"do": "see", "on": "diff.file", "text": "new-module.ts"},
            {"do": "see", "on": "diff.mode", "text": "Changed: 2"}
          ]
        },
        {
          "id": "editor-save",
          "kind": "path",
          "title": "A save in the file editor shows up in Changes",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff editor save"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "editor"},
            {"do": "click", "on": "files.row", "path": "src"},
            {"do": "click", "on": "files.row", "path": "src/api"},
            {"do": "click", "on": "files.row", "path": "src/api/client.ts"},
            {"do": "click", "on": "files.line", "text": "import { withRetry } from \"./retry\""},
            {"do": "press", "key": "End"},
            {"do": "type", "text": " // saved from the editor"},
            {"do": "press", "key": "s", "mods": ["mod"]},
            {"do": "file.expect", "path": "src/api/client.ts", "contains": "// saved from the editor"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "see", "on": "diff.file", "text": "client.ts"},
            {"do": "click", "on": "diff.file", "text": "client.ts"},
            {"do": "see", "on": "diff.added", "text": "// saved from the editor", "count": 1}
          ]
        }
      ]
    },
    {
      "id": "layout",
      "name": "Diff layout",
      "sources": ["packages/ui/src/components/views/DiffView.tsx", "packages/ui/src/components/chat/message/DiffViewToggle.tsx"],
      "what": "A file's diff shows as one column or side by side.",
      "reach": "Open a file in Changes, click the side-by-side button on its header.",
      "proof": "The diff switches to two columns and back.",
      "scenarios": [
        {
          "id": "side-by-side",
          "kind": "path",
          "title": "The side-by-side toggle splits the diff and joins it back",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff split"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.unified"},
            {"do": "click", "on": "diff.sideBySide"},
            {"do": "see", "on": "diff.split"},
            {"do": "see", "on": "diff.added", "text": "const isAbortError"},
            {"do": "click", "on": "diff.sideBySide"},
            {"do": "see", "on": "diff.unified"},
            {"do": "gone", "on": "diff.split"}
          ]
        }
      ]
    },
    {
      "id": "find",
      "name": "Find in changes",
      "sources": ["packages/ui/src/components/views/DiffView.tsx", "packages/ui/src/components/views/diffFind/DiffFindBar.tsx", "packages/ui/src/components/views/diffFind/useDiffFind.ts", "packages/ui/src/components/views/diffFind/useDiffFindSurface.ts", "packages/ui/src/components/views/diffFind/findDiffBatch.ts", "packages/ui/src/components/views/pierreDiff/useFindHighlights.ts", "packages/ui/src/components/views/pierreDiff/findHighlights.ts", "packages/ui/src/components/views/pierreDiff/useDiffScrollToLine.ts"],
      "what": "Cmd/Ctrl+F over Changes searches the diffs; every match is painted in its row, the active one stronger, and the arrows walk through them.",
      "reach": "Open a file in Changes, press Cmd/Ctrl+F, type a word.",
      "proof": "The matches are marked in the rows, the count reads N/M, Next moves the active mark to the next row, closing the bar removes every mark.",
      "scenarios": [
        {
          "id": "walk",
          "kind": "path",
          "title": "A search marks its 3 matches, Next moves to the second, closing clears the marks",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff find"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.added", "count": 12},
            {"do": "press", "key": "f", "mods": ["mod"]},
            {"do": "see", "on": "find.input"},
            {"do": "type", "text": "backoff"},
            {"do": "see", "on": "find.count", "text": "1/3"},
            {"do": "see", "on": "find.mark", "count": 3},
            {"do": "see", "on": "find.currentRow", "count": 1},
            {"do": "see", "on": "find.currentRow", "text": "Exponential backoff with full jitter"},
            {"do": "click", "on": "find.next"},
            {"do": "see", "on": "find.count", "text": "2/3"},
            {"do": "see", "on": "find.currentRow", "text": "const backoff = (baseDelayMs"},
            {"do": "see", "on": "find.currentRow", "count": 1},
            {"do": "see", "on": "find.mark", "count": 3},
            {"do": "click", "on": "find.close"},
            {"do": "gone", "on": "find.input"},
            {"do": "see", "on": "find.mark", "count": 0},
            {"do": "see", "on": "diff.added", "count": 12}
          ]
        }
      ]
    },
    {
      "id": "comment",
      "name": "Comments on diff lines",
      "sources": ["packages/ui/src/components/views/DiffView.tsx", "packages/ui/src/components/views/pierreDiff/useDiffComments.ts", "packages/ui/src/components/views/pierreDiff/useLineSelectionGestures.ts", "packages/ui/src/components/views/pierreDiff/useDiffAnnotations.ts", "packages/ui/src/components/views/pierreDiff/css.ts", "packages/ui/src/components/comments/PierreDiffCommentOverlays.tsx", "packages/ui/src/components/comments/InlineCommentInput.tsx", "packages/ui/src/components/comments/InlineCommentCard.tsx", "packages/ui/src/components/comments/useInlineCommentController.ts"],
      "what": "The + in the gutter opens a comment on that row; a drag over the code selects several rows and opens one comment on all of them. A saved comment stays under its rows; an empty one cannot be saved.",
      "reach": "Open a file in Changes, point at a row and click the + next to its number, or drag across rows of code.",
      "proof": "The field opens under the right rows, the saved card names its range and sits under the last row, Attach stays disabled and Enter saves nothing while the field is blank.",
      "scenarios": [
        {
          "id": "line",
          "kind": "path",
          "title": "The gutter + opens a comment on its row, and the saved comment stays under that row",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff line comment"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "hover", "on": "diff.added", "text": "const isAbortError"},
            {"do": "click", "on": "diff.lineComment"},
            {"do": "see", "on": "diff.commentField"},
            {"do": "see", "on": "diff.selectedLine", "count": 1},
            {"do": "see", "on": "diff.selectedLine", "text": "const isAbortError"},
            {"do": "type", "text": "Check the name, not the class"},
            {"do": "click", "on": "diff.commentSave"},
            {"do": "gone", "on": "diff.commentField"},
            {"do": "see", "on": "diff.comment", "count": 1},
            {"do": "see", "on": "diff.commentOnLine", "side": "additions", "line": "14", "text": "Check the name, not the class"},
            {"do": "see", "on": "diff.comment", "text": "Lines 14-14"}
          ]
        },
        {
          "id": "empty",
          "kind": "break",
          "title": "A blank comment cannot be saved: Attach stays disabled and Enter adds nothing",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff empty comment"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "hover", "on": "diff.added", "text": "const isAbortError"},
            {"do": "click", "on": "diff.lineComment"},
            {"do": "see", "on": "diff.commentField"},
            {"do": "see", "on": "diff.commentSave", "disabled": true},
            {"do": "type", "text": "   "},
            {"do": "see", "on": "diff.commentSave", "disabled": true},
            {"do": "press", "key": "Enter"},
            {"do": "steady", "on": "diff.comment", "count": 0, "ms": 1000},
            {"do": "see", "on": "diff.commentField"},
            {"do": "press", "key": "Escape"},
            {"do": "gone", "on": "diff.commentField"},
            {"do": "see", "on": "diff.comment", "count": 0}
          ]
        },
        {
          "id": "range",
          "kind": "path",
          "title": "A drag across five rows of code opens one comment that is saved on lines 10-14",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff range comment"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.added", "count": 12},
            {"do": "drag", "on": "diff.added", "text": "const timer = setTimeout", "to": {"on": "diff.added", "text": "const isAbortError"}},
            {"do": "see", "on": "diff.selectedLine", "count": 5},
            {"do": "see", "on": "diff.selectedLine", "text": "const timer = setTimeout"},
            {"do": "see", "on": "diff.selectedLine", "text": "const isAbortError"},
            {"do": "see", "on": "diff.commentField"},
            {"do": "type", "text": "The abort plumbing"},
            {"do": "click", "on": "diff.commentSave"},
            {"do": "gone", "on": "diff.commentField"},
            {"do": "see", "on": "diff.comment", "count": 1},
            {"do": "see", "on": "diff.commentOnLine", "side": "additions", "line": "14", "text": "The abort plumbing"},
            {"do": "see", "on": "diff.comment", "text": "Lines 10-14"}
          ]
        }
      ]
    },
    {
      "id": "context",
      "name": "Hidden context",
      "sources": ["packages/ui/src/components/views/DiffView.tsx", "packages/ui/src/components/views/pierreDiff/contextExpansion.ts", "packages/ui/src/components/views/pierreDiff/useContextExpansion.ts", "packages/ui/src/components/views/pierreDiff/useDiffAnnotations.ts", "packages/ui/src/components/views/pierreDiff/css.ts"],
      "what": "Unchanged lines between hunks are folded into a separator; a click on it shows them.",
      "reach": "Open a file with two hunks in Changes, click the separator between them.",
      "proof": "The folded lines are not in the diff before the click and are after it.",
      "scenarios": [
        {
          "id": "expand",
          "kind": "path",
          "title": "A click on the separator between the two hunks shows the 7 lines it folds",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff expand"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.added", "count": 12},
            {"do": "see", "on": "diff.line", "text": "const response = await run()", "count": 0},
            {"do": "click", "on": "diff.expandContext", "text": "7 unmodified lines"},
            {"do": "see", "on": "diff.line", "text": "const response = await run()", "count": 1},
            {"do": "see", "on": "diff.line", "text": "for (let attempt = 0", "count": 1},
            {"do": "see", "on": "diff.line", "text": "Server answered", "count": 1},
            {"do": "see", "on": "diff.added", "count": 12},
            {"do": "see", "on": "diff.removed", "count": 2}
          ]
        }
      ]
    },
    {
      "id": "hunk",
      "name": "Hunk actions",
      "sources": ["packages/ui/src/components/views/DiffView.tsx", "packages/ui/src/components/views/git/HunkActions.tsx", "packages/ui/src/components/views/pierreDiff/useHunkActionTargets.ts", "packages/ui/src/components/views/pierreDiff/useDiffAnnotations.ts", "packages/ui/src/components/views/pierreDiff/css.ts"],
      "what": "Pointing at a hunk of an unstaged diff shows Discard and Stage for that hunk alone.",
      "reach": "Open a changed file in Changes, point at a hunk, click Stage or Discard over its last line.",
      "proof": "Stage moves only that hunk to Staged; Discard, after its confirm, puts only that hunk back to the committed text on disk.",
      "scenarios": [
        {
          "id": "stage",
          "kind": "path",
          "title": "Stage on the first hunk leaves the second in Changed and moves the first to Staged",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff stage hunk"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.added", "count": 12},
            {"do": "hover", "on": "diff.added", "text": "const isAbortError"},
            {"do": "click", "on": "diff.hunkStage", "hunk": "1"},
            {"do": "see", "on": "diff.added", "count": 3},
            {"do": "see", "on": "diff.removed", "count": 1},
            {"do": "see", "on": "diff.added", "text": "if (options.signal?.aborted"},
            {"do": "click", "on": "diff.mode"},
            {"do": "click", "on": "menu.option", "text": "Staged"},
            {"do": "see", "on": "diff.mode", "text": "Staged: 1"},
            {"do": "see", "on": "diff.file", "text": "+9"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.added", "count": 9},
            {"do": "see", "on": "diff.added", "text": "const isAbortError"},
            {"do": "see", "on": "diff.removed", "count": 1}
          ]
        },
        {
          "id": "discard",
          "kind": "path",
          "title": "Discard on the second hunk, confirmed, restores only that hunk's lines on disk",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Diff discard hunk"},
            {"do": "session.send", "session": "s", "prompt": "Так, виправ у retry.ts."},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "diff"},
            {"do": "click", "on": "diff.file", "text": "retry.ts"},
            {"do": "see", "on": "diff.added", "count": 12},
            {"do": "hover", "on": "diff.added", "text": "if (options.signal?.aborted"},
            {"do": "click", "on": "diff.hunkDiscard", "hunk": "2"},
            {"do": "click", "on": "dialog.button", "text": "Discard", "exact": true},
            {"do": "file.expect", "path": "src/api/retry.ts", "contains": "    } catch (error) {\n      lastError = error\n      await sleep(options.baseDelayMs * 2 ** attempt)\n    }\n  }"},
            {"do": "file.expect", "path": "src/api/retry.ts", "contains": "const isAbortError = (error: unknown)"},
            {"do": "see", "on": "diff.added", "count": 9},
            {"do": "see", "on": "diff.removed", "count": 1},
            {"do": "see", "on": "diff.added", "text": "if (options.signal?.aborted", "count": 0}
          ]
        }
      ]
    }
  ]
}

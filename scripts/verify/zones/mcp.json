{
  "zone": "mcp",
  "name": "MCP server settings",
  "sources": ["packages/ui/src/components/sections/mcp/McpPage.tsx", "packages/ui/src/components/sections/mcp/McpGrid.tsx"],
  "features": [
    {
      "id": "draft",
      "name": "New server drafts",
      "sources": ["packages/ui/src/components/sections/mcp/McpGrid.tsx", "packages/ui/src/components/sections/mcp/McpPage.tsx", "packages/ui/src/components/sections/mcp/mcpDraft.ts"],
      "what": "A new server stays a draft until Create; Cancel discards it and required connection fields are checked.",
      "reach": "Settings > MCP > Add MCP server.",
      "proof": "Cancel restores the grid without a file; Create names missing fields and a completed project server persists on disk.",
      "scenarios": [
        {
          "id": "cancel",
          "kind": "path",
          "title": "A normalized name and command remain a draft and Cancel discards them",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "see", "on": "dialog", "text": "No MCP servers"},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.name", "clicks": 3},
            {"do": "type", "text": "My Server!"},
            {"do": "field", "on": "mcp.name", "equals": "my-server-"},
            {"do": "click", "on": "settings.field", "item": "mcp.command"},
            {"do": "type", "text": "unused-command"},
            {"do": "click", "on": "settings.field", "item": "mcp.command", "clicks": 3},
            {"do": "type", "text": "http://localhost:1/mcp"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "http://localhost:1/mcp"},
            {"do": "click", "on": "settings.field", "item": "mcp.command", "clicks": 3},
            {"do": "type", "text": "node --label \"two words\""},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "node\n--label\ntwo words"},
            {"do": "click", "on": "mcp.button", "text": "Cancel", "exact": true},
            {"do": "see", "on": "dialog", "text": "No MCP servers"},
            {"do": "file.expect", "path": ".opencode/opencode.json", "exists": false},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": ""}
          ]
        },
        {
          "id": "required",
          "kind": "break",
          "title": "Create refuses an empty local command and an empty remote link without leaving the draft",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.name", "clicks": 3},
            {"do": "press", "key": "Backspace"},
            {"do": "see", "on": "mcp.button", "text": "Create", "exact": true, "disabled": true},
            {"do": "type", "text": "required"},
            {"do": "click", "on": "mcp.button", "text": "Create", "exact": true},
            {"do": "see", "on": "toast", "text": "Command cannot be empty"},
            {"do": "click", "on": "mcp.button", "text": "Link", "exact": true},
            {"do": "click", "on": "mcp.button", "text": "Create", "exact": true},
            {"do": "see", "on": "toast", "text": "URL cannot be empty"},
            {"do": "field", "on": "mcp.name", "equals": "required"},
            {"do": "file.expect", "path": ".opencode/opencode.json", "exists": false}
          ]
        },
        {
          "id": "create",
          "kind": "break",
          "title": "A failed Create retains the project draft for retry and the created command survives reload",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.name", "clicks": 3},
            {"do": "type", "text": "project-server"},
            {"do": "click", "on": "mcp.scope"},
            {"do": "click", "on": "mcp.option", "text": "Only in this project"},
            {"do": "click", "on": "settings.checkboxLabel", "label": "Enable server"},
            {"do": "click", "on": "settings.field", "item": "mcp.command"},
            {"do": "type", "text": "unused-command\n--flag"},
            {"do": "file.expect", "path": ".opencode/opencode.json", "exists": false},
            {"do": "network.block", "urls": ["*/api/config/mcp*"]},
            {"do": "click", "on": "mcp.button", "text": "Create", "exact": true},
            {"do": "see", "on": "toast.error"},
            {"do": "field", "on": "mcp.name", "equals": "project-server"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "unused-command\n--flag"},
            {"do": "file.expect", "path": ".opencode/opencode.json", "exists": false},
            {"do": "network.allow"},
            {"do": "click", "on": "mcp.button", "text": "Create", "exact": true},
            {"do": "gone", "on": "mcp.name"},
            {"do": "file.expect", "path": ".opencode/opencode.json", "contains": "\"project-server\""},
            {"do": "file.expect", "path": ".opencode/opencode.json", "contains": "\"disabled\": true"},
            {"do": "click", "on": "mcp.back"},
            {"do": "see", "on": "mcp.card", "name": "project-server", "text": "Disabled"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "project-server"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "unused-command\n--flag"},
            {"do": "see", "on": "settings.checkedLabel", "label": "Enable server", "checked": "false"}
          ]
        },
        {
          "id": "duplicate",
          "kind": "break",
          "title": "A duplicate name is rejected and leaves the original configuration intact",
          "steps": [
            {"do": "file.write", "path": "opencode.json", "content": "{\"mcp\":{\"servers\":{\"existing\":{\"type\":\"local\",\"command\":[\"original-command\"],\"disabled\":true}}}}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "see", "on": "mcp.card", "name": "existing"},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.name", "clicks": 3},
            {"do": "type", "text": "existing"},
            {"do": "click", "on": "settings.field", "item": "mcp.command"},
            {"do": "type", "text": "replacement-command"},
            {"do": "click", "on": "mcp.button", "text": "Create", "exact": true},
            {"do": "see", "on": "toast", "text": "A server with this name already exists"},
            {"do": "field", "on": "mcp.name", "equals": "existing"},
            {"do": "file.expect", "path": "opencode.json", "contains": "original-command"}
          ]
        }
      ]
    },
    {
      "id": "browse",
      "name": "Finding configured servers",
      "sources": ["packages/ui/src/components/sections/mcp/McpGrid.tsx"],
      "what": "Search matches server names and connection targets; an unmatched query can be cleared.",
      "reach": "Settings > MCP > Search servers.",
      "proof": "Only the matching card remains, an unmatched search says so, and clearing restores the cards.",
      "scenarios": [{
        "id": "search",
        "kind": "path",
        "title": "Search finds a command target, recovers from no matches and opens the right card",
        "steps": [
          {"do": "file.write", "path": "opencode.json", "content": "{\"mcp\":{\"servers\":{\"alpha\":{\"type\":\"local\",\"command\":[\"alpha-command\"],\"disabled\":true},\"beta\":{\"type\":\"remote\",\"url\":\"http://localhost:1/mcp\",\"disabled\":true}}}}"},
          {"do": "open"},
          {"do": "click", "on": "sidebar.settings"},
          {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
          {"do": "see", "on": "mcp.card", "name": "alpha", "text": "Disabled"},
          {"do": "click", "on": "mcp.search"},
          {"do": "type", "text": "alpha-command"},
          {"do": "see", "on": "mcp.card", "name": "alpha"},
          {"do": "gone", "on": "mcp.card", "name": "beta"},
          {"do": "gone", "on": "mcp.button", "text": "Add MCP server"},
          {"do": "click", "on": "mcp.search", "clicks": 3},
          {"do": "type", "text": "zzzz-no-server"},
          {"do": "see", "on": "dialog", "text": "No servers match"},
          {"do": "gone", "on": "mcp.card", "name": "alpha"},
          {"do": "click", "on": "mcp.search", "clicks": 3},
          {"do": "press", "key": "Backspace"},
          {"do": "see", "on": "mcp.card", "name": "beta"},
          {"do": "click", "on": "mcp.card", "name": "alpha"},
          {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "alpha-command"}
        ]
      }]
    },
    {
      "id": "import",
      "name": "Importing JSON snippets",
      "sources": ["packages/ui/src/components/sections/mcp/McpPage.tsx", "packages/ui/src/components/sections/mcp/mcpImport.ts", "packages/ui/src/components/sections/mcp/mcpDraft.ts"],
      "what": "A single v1 or v2 server snippet populates a draft for review. Invalid JSON, multiple servers and clipboard refusal leave the form available.",
      "reach": "Add MCP server > Import from JSON snippet.",
      "proof": "Imported fields and normalized name appear without a write; invalid input stays in the dialog with an explanation and can be corrected.",
      "scenarios": [
        {
          "id": "local",
          "kind": "path",
          "title": "A legacy command and args snippet fills the draft and converts its timeout to execution",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.button", "text": "Import from JSON snippet"},
            {"do": "click", "on": "mcp.importText"},
            {"do": "type", "text": "{\"mcpServers\":{\" My Server! \":{\"command\":\"unused-command\",\"args\":[\"--label\",\"two words\"],\"env\":{\"REGION\":\"west\"},\"timeout\":4500,\"disabled\":true}}}"},
            {"do": "click", "on": "dialog.button", "text": "Import", "exact": true},
            {"do": "gone", "on": "mcp.importText"},
            {"do": "field", "on": "mcp.name", "equals": "my-server"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "unused-command\n--label\ntwo words"},
            {"do": "field", "on": "mcp.envKey", "equals": "REGION"},
            {"do": "field", "on": "mcp.envValue", "equals": "west"},
            {"do": "see", "on": "mcp.advanced", "text": "execution 4500ms"},
            {"do": "see", "on": "settings.checkedLabel", "label": "Enable server", "checked": "false"},
            {"do": "file.expect", "path": ".opencode/opencode.json", "exists": false}
          ]
        },
        {
          "id": "remote",
          "kind": "path",
          "title": "A v2 remote snippet from the clipboard fills its link, headers and advanced options",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.button", "text": "Import from JSON snippet"},
            {"do": "clipboard", "set": "{\"mcp\":{\"servers\":{\"remote\":{\"type\":\"remote\",\"url\":\"http://localhost:1/mcp\",\"headers\":{\"X-Region\":\"west\"},\"timeout\":{\"catalog\":2000,\"execution\":3000},\"codemode\":false,\"protocol\":\"auto\",\"disabled\":true}}}}"},
            {"do": "click", "on": "dialog.button", "text": "Paste JSON from clipboard", "exact": true},
            {"do": "click", "on": "dialog.button", "text": "Import", "exact": true},
            {"do": "field", "on": "mcp.name", "equals": "remote"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "http://localhost:1/mcp"},
            {"do": "see", "on": "mcp.advanced", "text": "1 headers"},
            {"do": "see", "on": "mcp.advanced", "text": "catalog 2s"},
            {"do": "see", "on": "mcp.advanced", "text": "execution 3s"},
            {"do": "click", "on": "mcp.advanced"},
            {"do": "see", "on": "mcp.select", "label": "Code mode", "text": "Off"},
            {"do": "see", "on": "mcp.select", "label": "Protocol", "text": "Auto"},
            {"do": "field", "on": "mcp.headerKey", "equals": "X-Region"},
            {"do": "field", "on": "mcp.headerValue", "equals": "west"}
          ]
        },
        {
          "id": "invalid",
          "kind": "break",
          "title": "Malformed and multi-server snippets explain the error and correcting the snippet recovers",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.button", "text": "Import from JSON snippet"},
            {"do": "see", "on": "dialog.button", "text": "Import", "exact": true, "disabled": true},
            {"do": "click", "on": "mcp.importText"},
            {"do": "type", "text": "{broken"},
            {"do": "click", "on": "dialog.button", "text": "Import", "exact": true},
            {"do": "see", "on": "dialog", "text": "Invalid JSON"},
            {"do": "click", "on": "mcp.importText", "clicks": 3},
            {"do": "type", "text": "{\"mcpServers\":{\"a\":{},\"b\":{}}}"},
            {"do": "click", "on": "dialog.button", "text": "Import", "exact": true},
            {"do": "see", "on": "dialog", "text": "Paste one server at a time"},
            {"do": "click", "on": "mcp.importText", "clicks": 3},
            {"do": "type", "text": "{\"type\":\"local\",\"command\":[\"corrected\"]}"},
            {"do": "click", "on": "dialog.button", "text": "Import", "exact": true},
            {"do": "gone", "on": "mcp.importText"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "corrected"}
          ]
        },
        {
          "id": "clipboard-denied",
          "kind": "break",
          "title": "A refused clipboard read keeps the import dialog usable for manual entry",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.button", "text": "Add MCP server"},
            {"do": "click", "on": "mcp.button", "text": "Import from JSON snippet"},
            {"do": "clipboard.permission", "state": "denied"},
            {"do": "click", "on": "dialog.button", "text": "Paste JSON from clipboard", "exact": true},
            {"do": "see", "on": "toast", "text": "Cannot read clipboard"},
            {"do": "field", "on": "mcp.importText", "equals": ""},
            {"do": "click", "on": "mcp.importText"},
            {"do": "type", "text": "{\"type\":\"local\",\"command\":[\"manual-entry\"]}"},
            {"do": "click", "on": "dialog.button", "text": "Import", "exact": true},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "manual-entry"}
          ]
        }
      ]
    },
    {
      "id": "edit",
      "name": "Autosaving server configuration",
      "what": "Existing servers save on blur and immediate controls save at once; failed writes retain the edit for retry.",
      "reach": "Settings > MCP > a configured server.",
      "proof": "Disk and reopened fields reflect the edits, hidden OAuth fields survive, and failed saves leave the draft intact.",
      "scenarios": [
        {
          "id": "remote",
          "kind": "path",
          "title": "Editing a remote link saves on blur and preserves stored OAuth fields",
          "steps": [
            {"do": "file.write", "path": "opencode.json", "content": "{\"mcp\":{\"servers\":{\"remote\":{\"type\":\"remote\",\"url\":\"http://localhost:1/old\",\"disabled\":true,\"oauth\":{\"client_id\":\"fixture-client\",\"scope\":\"read\"}}}}}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "remote"},
            {"do": "click", "on": "settings.field", "item": "mcp.command", "clicks": 3},
            {"do": "type", "text": "http://localhost:1/edited"},
            {"do": "press", "key": "Tab"},
            {"do": "file.expect", "path": "opencode.json", "contains": "http://localhost:1/edited"},
            {"do": "file.expect", "path": "opencode.json", "contains": "\"client_id\":\"fixture-client\""},
            {"do": "file.expect", "path": "opencode.json", "contains": "\"scope\":\"read\""},
            {"do": "click", "on": "mcp.back"},
            {"do": "click", "on": "mcp.card", "name": "remote"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "http://localhost:1/edited"},
            {"do": "see", "on": "mcp.button", "text": "Connect", "exact": true, "disabled": true}
          ]
        },
        {
          "id": "save-failure",
          "kind": "break",
          "title": "A refused save reports failure and retains the command for retry on the next blur",
          "steps": [
            {"do": "file.write", "path": "opencode.json", "content": "{\"mcp\":{\"servers\":{\"local\":{\"type\":\"local\",\"command\":[\"original\"],\"disabled\":true}}}}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "local"},
            {"do": "network.block", "urls": ["*/api/config/mcp/local*"]},
            {"do": "click", "on": "settings.field", "item": "mcp.command", "clicks": 3},
            {"do": "type", "text": "retained-edit"},
            {"do": "press", "key": "Tab"},
            {"do": "see", "on": "toast", "text": "Couldn't save"},
            {"do": "field", "on": "settings.field", "item": "mcp.command", "equals": "retained-edit"},
            {"do": "file.expect", "path": "opencode.json", "contains": "original"},
            {"do": "network.allow"},
            {"do": "click", "on": "settings.field", "item": "mcp.command"},
            {"do": "press", "key": "Tab"},
            {"do": "file.expect", "path": "opencode.json", "contains": "retained-edit"}
          ]
        },
        {
          "id": "advanced",
          "kind": "path",
          "title": "Timeout and Code mode autosave and remain summarized after reopening",
          "steps": [
            {"do": "file.write", "path": "opencode.json", "content": "{\"mcp\":{\"servers\":{\"local\":{\"type\":\"local\",\"command\":[\"unused\"],\"disabled\":true}}}}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "local"},
            {"do": "click", "on": "mcp.advanced"},
            {"do": "click", "on": "mcp.startup"},
            {"do": "type", "text": "2000"},
            {"do": "press", "key": "Tab"},
            {"do": "file.expect", "path": "opencode.json", "contains": "\"startup\": 2000"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "local"},
            {"do": "see", "on": "mcp.advanced", "text": "startup 2s"},
            {"do": "click", "on": "mcp.advanced"},
            {"do": "field", "on": "mcp.startup", "equals": "2000"},
            {"do": "click", "on": "mcp.select", "label": "Code mode"},
            {"do": "click", "on": "mcp.option", "text": "Off", "exact": true},
            {"do": "file.expect", "path": "opencode.json", "contains": "\"codemode\": false"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "local"},
            {"do": "see", "on": "mcp.advanced", "text": "startup 2s"},
            {"do": "click", "on": "mcp.advanced"},
            {"do": "field", "on": "mcp.startup", "equals": "2000"},
            {"do": "see", "on": "mcp.select", "label": "Code mode", "text": "Off"}
          ]
        },
        {
          "id": "metadata-invalid",
          "kind": "break",
          "title": "An invalid OAuth metadata address prevents autosave and a corrected address saves",
          "steps": [
            {"do": "file.write", "path": "opencode.json", "content": "{\"mcp\":{\"servers\":{\"remote\":{\"type\":\"remote\",\"url\":\"http://localhost:1/mcp\",\"disabled\":true,\"oauth\":{}}}}}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "remote"},
            {"do": "click", "on": "mcp.advanced"},
            {"do": "click", "on": "mcp.metadata"},
            {"do": "type", "text": "not-an-address"},
            {"do": "press", "key": "Tab"},
            {"do": "see", "on": "mcp.metadataInvalid"},
            {"do": "see", "on": "toast", "text": "Couldn't save"},
            {"do": "file.expect", "path": "opencode.json", "contains": "\"oauth\":{}"},
            {"do": "click", "on": "mcp.metadata", "clicks": 3},
            {"do": "type", "text": "http://localhost:1/metadata"},
            {"do": "press", "key": "Tab"},
            {"do": "gone", "on": "mcp.metadataInvalid"},
            {"do": "file.expect", "path": "opencode.json", "contains": "http://localhost:1/metadata"}
          ]
        }
      ]
    },
    {
      "id": "environment",
      "name": "Environment variables",
      "what": "Variables are masked, can be revealed, merged from .env and removed; malformed clipboard content is refused.",
      "reach": "A server's Environment variables section.",
      "proof": "Show and Hide change masking, clipboard import updates duplicate keys, removal persists, and invalid clipboard data leaves the old value.",
      "scenarios": [
        {
          "id": "merge-remove",
          "kind": "path",
          "title": "Paste .env merges keys, Show and Hide protect values, and removing a row autosaves",
          "steps": [
            {"do": "file.write", "path": "opencode.json", "content": "{\"mcp\":{\"servers\":{\"local\":{\"type\":\"local\",\"command\":[\"unused\"],\"disabled\":true,\"environment\":{\"REGION\":\"old\"}}}}}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "MCP", "exact": true, "timeout": 60},
            {"do": "click", "on": "mcp.card", "name": "local"},
            {"do": "gone", "on": "mcp.envRevealed"},
            {"do": "click", "on": "mcp.envAction", "label": "Show"},

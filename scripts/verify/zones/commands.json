{
  "zone": "commands",
  "name": "Slash command settings",
  "sources": [
    "packages/ui/src/components/sections/commands/CommandsPage.tsx",
    "packages/ui/src/components/sections/commands/CommandsSidebar.tsx"
  ],
  "features": [
    {
      "id": "create",
      "name": "Creating command drafts",
      "what": "A new command stays off disk until Create, validates its name and template, and writes to Global or Project. Cancel discards it and a failed write leaves it available to retry.",
      "reach": "Settings > Commands > +.",
      "proof": "The new command reopens with its template; project creation writes the named Markdown file. Cancellation, missing fields and rejected writes leave no project file.",
      "scenarios": [
        {
          "id": "global",
          "kind": "path",
          "title": "Global is the default destination and its command survives reload without a project file",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "see", "on": "commands.row", "text": "/init"},
            {"do": "click", "on": "commands.create"},
            {"do": "see", "on": "commands.scope", "text": "Global"},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "type", "text": "Global template"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Global template"},
            {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
            {"do": "gone", "on": "commands.name"},
            {"do": "see", "on": "commands.row", "text": "/new-command"},
            {"do": "file.expect", "path": ".opencode/commands/new-command.md", "exists": false},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "commands.row", "text": "/new-command", "timeout": 60},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Global template"},
            {"do": "click", "on": "commands.row", "text": "/new-command", "button": "right"},
            {"do": "click", "on": "menu.item", "text": "Delete", "exact": true},
            {"do": "click", "on": "dialog.button", "text": "Delete", "exact": true},
            {"do": "gone", "on": "commands.row", "text": "/new-command"}
          ]
        },
        {
          "id": "project",
          "kind": "path",
          "title": "Create normalizes spaces in a project command name and persists its description and template",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.create"},
            {"do": "click", "on": "commands.name", "clicks": 3},
            {"do": "type", "text": "net helper"},
            {"do": "click", "on": "commands.scope"},
            {"do": "click", "on": "agents.option", "text": "Project", "exact": true},
            {"do": "click", "on": "commands.description"},
            {"do": "type", "text": "Review local changes"},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "type", "text": "Review $ARGUMENTS in @src/api/client.ts"},
            {"do": "click", "on": "commands.description"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "exists": false},
            {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "Review $ARGUMENTS in @src/api/client.ts"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "description: Review local changes"},
            {"do": "gone", "on": "commands.name"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "commands.row", "text": "/net-helper", "timeout": 60},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Review $ARGUMENTS in @src/api/client.ts"},
            {"do": "field", "on": "commands.description", "equals": "Review local changes"}
          ]
        },
        {
          "id": "cancel",
          "kind": "path",
          "title": "Cancel discards a completed project draft without writing a command",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.create"},
            {"do": "click", "on": "commands.scope"},
            {"do": "click", "on": "agents.option", "text": "Project", "exact": true},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "type", "text": "Discard this template"},
            {"do": "click", "on": "dialog.button", "text": "Cancel", "exact": true},
            {"do": "gone", "on": "commands.name"},
            {"do": "gone", "on": "settings.field", "item": "commands.template"},
            {"do": "file.expect", "path": ".opencode/commands/new-command.md", "exists": false},
            {"do": "click", "on": "commands.create"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": ""}
          ]
        },
        {
          "id": "required",
          "kind": "break",
          "title": "Missing template or name disables Create and filling both enables it",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.create"},
            {"do": "see", "on": "dialog.button", "text": "Create", "exact": true, "disabled": true},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "type", "text": "Required template"},
            {"do": "see", "on": "dialog.button", "text": "Create", "exact": true, "disabled": false},
            {"do": "click", "on": "commands.name", "clicks": 3},
            {"do": "press", "key": "Backspace"},
            {"do": "see", "on": "dialog.button", "text": "Create", "exact": true, "disabled": true},
            {"do": "type", "text": "net-required"},
            {"do": "see", "on": "dialog.button", "text": "Create", "exact": true, "disabled": false}
          ]
        },
        {
          "id": "taken",
          "kind": "break",
          "title": "An existing command name is refused without changing the original",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Original helper\n---\nOriginal template"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "see", "on": "commands.row", "text": "/net-helper"},
            {"do": "click", "on": "commands.create"},
            {"do": "click", "on": "commands.name", "clicks": 3},
            {"do": "type", "text": "net-helper"},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "type", "text": "Replacement template"},
            {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
            {"do": "see", "on": "toast", "text": "A command with this name already exists"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Replacement template"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "Original template"}
          ]
        },
        {
          "id": "write-failure",
          "kind": "break",
          "title": "A failed Create retains the project draft and succeeds on retry",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.create"},
            {"do": "click", "on": "commands.scope"},
            {"do": "click", "on": "agents.option", "text": "Project", "exact": true},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "type", "text": "Keep this draft for retry"},
            {"do": "network.block", "urls": ["*/api/config/commands/new-command?*"]},
            {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
            {"do": "see", "on": "toast", "text": "Failed to create command"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Keep this draft for retry"},
            {"do": "file.expect", "path": ".opencode/commands/new-command.md", "exists": false},
            {"do": "network.allow"},
            {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
            {"do": "file.expect", "path": ".opencode/commands/new-command.md", "contains": "Keep this draft for retry"},
            {"do": "gone", "on": "commands.name"}
          ]
        }
      ]
    },
    {
      "id": "browse",
      "name": "Finding commands",
      "sources": ["packages/ui/src/components/sections/commands/CommandsSidebar.tsx", "packages/ui/src/components/sections/commands/CommandsPage.tsx"],
      "what": "Search matches names and descriptions, Escape clears it, and commands originating from skills stay in Skills.",
      "reach": "Settings > Commands > Search, then a command row.",
      "proof": "An unmatched filter recovers; a description finds only its command, whose template opens. A skill with a slash command never appears in this list.",
      "scenarios": [{
        "id": "search",
        "kind": "path",
        "title": "Search recovers from no matches, finds a description and opens its command without listing skills",
        "steps": [
          {"do": "file.write", "path": ".opencode/commands/net-alpha.md", "content": "---\ndescription: Inspect frobnicator\n---\nAlpha template"},
          {"do": "file.write", "path": ".opencode/commands/net-beta.md", "content": "---\ndescription: Other helper\n---\nBeta template"},
          {"do": "file.write", "path": ".opencode/skills/net-skill/SKILL.md", "content": "---\nname: net-skill\ndescription: A skill command\n---\nSkill instructions"},
          {"do": "open"},
          {"do": "click", "on": "sidebar.settings"},
          {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
          {"do": "see", "on": "commands.row", "text": "/net-alpha"},
          {"do": "gone", "on": "commands.row", "text": "/net-skill"},
          {"do": "click", "on": "commands.search"},
          {"do": "type", "text": "zzzznomatch"},
          {"do": "gone", "on": "commands.row", "text": "/net-alpha"},
          {"do": "see", "on": "dialog", "text": "Nothing matches"},
          {"do": "press", "key": "Escape"},
          {"do": "see", "on": "commands.row", "text": "/net-beta"},
          {"do": "type", "text": "frobnicator"},
          {"do": "see", "on": "commands.row", "text": "/net-alpha"},
          {"do": "gone", "on": "commands.row", "text": "/net-beta"},
          {"do": "click", "on": "commands.row", "text": "/net-alpha"},
          {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Alpha template"}
        ]
      }]
    },
    {
      "id": "edit",
      "name": "Autosaving command text",
      "sources": ["packages/ui/src/components/sections/commands/CommandsPage.tsx"],
      "what": "Description and template save on blur. An empty template or a failed write preserves the stored command and leaves the edit available to correct or retry.",
      "reach": "Settings > Commands > an existing command.",
      "proof": "Disk and reopened fields hold the edited text; invalid and rejected saves show errors and keep the old disk content until recovery.",
      "scenarios": [
        {
          "id": "text",
          "kind": "path",
          "title": "Description and template save on blur and survive reopening",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Original helper\n---\nOriginal template"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.row", "text": "/net-helper"},
            {"do": "click", "on": "commands.description", "clicks": 3},
            {"do": "type", "text": "Edited helper"},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "description: Edited helper"},
            {"do": "click", "on": "settings.field", "item": "commands.template", "clicks": 3},
            {"do": "type", "text": "Edited $ARGUMENTS\nSecond line"},
            {"do": "click", "on": "commands.description"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "Edited $ARGUMENTS\nSecond line"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "commands.row", "text": "/net-helper", "timeout": 60},
            {"do": "field", "on": "commands.description", "equals": "Edited helper"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Edited $ARGUMENTS\nSecond line"}
          ]
        },
        {
          "id": "empty-template",
          "kind": "break",
          "title": "An empty template cannot autosave and correcting it recovers",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Original helper\n---\nOriginal template"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.row", "text": "/net-helper"},
            {"do": "click", "on": "settings.field", "item": "commands.template", "clicks": 3},
            {"do": "press", "key": "Backspace"},
            {"do": "click", "on": "commands.description"},
            {"do": "see", "on": "toast", "text": "Command template is required"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "Original template"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": ""},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "type", "text": "Corrected template"},
            {"do": "click", "on": "commands.description"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "Corrected template"}
          ]
        },
        {
          "id": "write-failure",
          "kind": "break",
          "title": "A refused autosave keeps the edited template and the next blur retries it",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Original helper\n---\nOriginal template"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.row", "text": "/net-helper"},
            {"do": "network.block", "urls": ["*/api/config/commands/net-helper?*"]},
            {"do": "click", "on": "settings.field", "item": "commands.template", "clicks": 3},
            {"do": "type", "text": "Retry this template"},
            {"do": "click", "on": "commands.description"},
            {"do": "see", "on": "toast", "text": "Failed to update command"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Retry this template"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "Original template"},
            {"do": "network.allow"},
            {"do": "click", "on": "settings.field", "item": "commands.template"},
            {"do": "click", "on": "commands.description"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "Retry this template"}
          ]
        }
      ]
    },
    {
      "id": "execution",
      "name": "Command execution overrides",
      "sources": ["packages/ui/src/components/sections/commands/CommandsPage.tsx", "packages/ui/src/components/sections/commands/AgentSelector.tsx"],
      "what": "A command can override its agent, model and thinking variant, or run as a subagent. Clearing overrides restores inheritance.",
      "reach": "An existing command > Execution context.",
      "proof": "Agent and subagent choices save immediately; a model and variant round-trip through disk and reopening, then Not selected clears the override.",
      "scenarios": [
        {
          "id": "agent",
          "kind": "path",
          "title": "Picking and clearing an agent and switching subagent save immediately",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Original helper\n---\nOriginal template"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.row", "text": "/net-helper"},
            {"do": "click", "on": "settings.menu", "item": "commands.agent"},
            {"do": "click", "on": "menu.item", "text": "Plan", "exact": true},
            {"do": "see", "on": "settings.menu", "item": "commands.agent", "text": "plan"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "agent: plan"},
            {"do": "click", "on": "settings.switch", "item": "commands.subagent"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "subagent: true"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "commands.row", "text": "/net-helper", "timeout": 60},
            {"do": "see", "on": "settings.menu", "item": "commands.agent", "text": "plan"},
            {"do": "see", "on": "settings.switchOn", "item": "commands.subagent"},
            {"do": "click", "on": "settings.menu", "item": "commands.agent"},
            {"do": "click", "on": "menu.item", "text": "Not selected", "exact": true},
            {"do": "see", "on": "settings.menu", "item": "commands.agent", "text": "Not selected"},
            {"do": "click", "on": "settings.switch", "item": "commands.subagent"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "subagent: false"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "commands.row", "text": "/net-helper", "timeout": 60},
            {"do": "see", "on": "settings.menu", "item": "commands.agent", "text": "Not selected"},
            {"do": "see", "on": "settings.switchOff", "item": "commands.subagent"}
          ]
        },
        {
          "id": "model",
          "kind": "path",
          "title": "A fixture model and variant persist and clearing the model removes the override",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Original helper\n---\nOriginal template"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.row", "text": "/net-helper"},
            {"do": "see", "on": "settings.field", "item": "commands.variant", "disabled": true},
            {"do": "click", "on": "settings.menu", "item": "commands.model"},
            {"do": "click", "on": "picker.search"},
            {"do": "type", "text": "code, seeding"},
            {"do": "click", "on": "picker.option", "text": "Fixture code, seeding speed"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "model: perf/code-20000cps"},
            {"do": "click", "on": "settings.field", "item": "commands.variant"},
            {"do": "type", "text": "high"},
            {"do": "click", "on": "commands.description"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper.md", "contains": "perf/code-20000cps#high"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "commands.row", "text": "/net-helper", "timeout": 60},
            {"do": "see", "on": "settings.menu", "item": "commands.model", "text": "Fixture code, seeding speed"},
            {"do": "field", "on": "settings.field", "item": "commands.variant", "equals": "high"},
            {"do": "click", "on": "settings.menu", "item": "commands.model"},
            {"do": "click", "on": "agents.noModel", "text": "Not selected", "exact": true},
            {"do": "see", "on": "settings.menu", "item": "commands.model", "text": "Not selected"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "commands.row", "text": "/net-helper", "timeout": 60},
            {"do": "see", "on": "settings.menu", "item": "commands.model", "text": "Not selected"},
            {"do": "field", "on": "settings.field", "item": "commands.variant", "equals": ""},
            {"do": "see", "on": "settings.field", "item": "commands.variant", "disabled": true}
          ]
        }
      ]
    },
    {
      "id": "manage",
      "name": "Duplicating, renaming and removing commands",
      "what": "Duplicate opens an editable copy draft. Rename normalizes spaces and preserves configuration. Deletion asks first and failed writes report what remains.",
      "reach": "Right-click a command row > Duplicate, Rename or Delete.",
      "proof": "The copy carries the original fields; rename moves the command on disk; cancellation and failed deletion keep the command until retry succeeds.",
      "scenarios": [
        {
          "id": "duplicate",
          "kind": "path",
          "title": "Duplicate finds a free copy name and preserves the source configuration as an unwritten draft",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Copy this helper\nagent: plan\nmodel: perf/code-20000cps#high\nsubagent: true\n---\nOriginal $ARGUMENTS"},
            {"do": "file.write", "path": ".opencode/commands/net-helper-copy.md", "content": "---\ndescription: Existing copy\n---\nLeave this alone"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "dialog.button", "text": "Commands", "exact": true, "timeout": 60},
            {"do": "click", "on": "commands.row", "text": "/net-helper", "button": "right", "exact": false, "index": 0},
            {"do": "click", "on": "menu.item", "text": "Duplicate", "exact": true},
            {"do": "field", "on": "commands.name", "equals": "net-helper-copy-2"},
            {"do": "see", "on": "commands.scope", "text": "Project"},
            {"do": "field", "on": "commands.description", "equals": "Copy this helper"},
            {"do": "field", "on": "settings.field", "item": "commands.template", "equals": "Original $ARGUMENTS"},
            {"do": "see", "on": "settings.menu", "item": "commands.agent", "text": "plan"},
            {"do": "field", "on": "settings.field", "item": "commands.variant", "equals": "high"},
            {"do": "see", "on": "settings.switchOn", "item": "commands.subagent"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper-copy-2.md", "exists": false},
            {"do": "click", "on": "dialog.button", "text": "Create", "exact": true},
            {"do": "file.expect", "path": ".opencode/commands/net-helper-copy-2.md", "contains": "model: perf/code-20000cps#high"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper-copy-2.md", "contains": "Original $ARGUMENTS"},
            {"do": "file.expect", "path": ".opencode/commands/net-helper-copy.md", "contains": "Leave this alone"}
          ]
        },
        {
          "id": "rename",
          "kind": "path",
          "title": "Rename cancels, rejects blank and taken names, then Enter normalizes and preserves the command",
          "steps": [
            {"do": "file.write", "path": ".opencode/commands/net-helper.md", "content": "---\ndescription: Original helper\nagent: plan\nmodel: perf/code-20000cps#high\nsubagent: true\n---\nOriginal template"},
            {"do": "file.write", "path": ".opencode/commands/net-taken.md", "content": "---\ndescription: Taken\n---\nOther template"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},

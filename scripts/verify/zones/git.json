{
  "zone": "git",
  "name": "Local Git work",
  "sources": ["packages/ui/src/components/views/GitView.tsx", "packages/ui/src/components/views/git/"],
  "features": [
    {
      "id": "changes",
      "name": "Staging and reverting files",
      "sources": ["packages/ui/src/components/views/GitView.tsx", "packages/ui/src/components/views/git/UnifiedWorkingChangesBody.tsx", "packages/ui/src/components/views/git/useUnifiedGitPanel.ts", "packages/ui/src/components/views/git/ChangesPanel.tsx", "packages/ui/src/components/views/git/ChangesTreeRows.tsx", "packages/ui/src/components/views/git/ChangedPathLabel.tsx", "packages/ui/src/components/views/git/GitEmptyState.tsx", "packages/ui/src/components/views/git/changeStatus.ts", "packages/ui/src/components/views/git/changesTree.ts", "packages/ui/src/components/views/git/gitIndexMutationQueue.ts"],
      "what": "Files move between Changes and Staged, individually, by folder or together; reverting asks first and restores the files on disk.",
      "reach": "Git on the right rail: narrow, the file accordions and their stage or revert buttons; expanded wide, the sidebar tree.",
      "proof": "The opposite stage action appears, a file's header opens its diff, and confirmed reverts restore tracked files and remove new files.",
      "scenarios": [
        {
          "id": "tree-folder", "kind": "path",
          "title": "The wide panel's tree folds a compact folder and stages only that folder",
          "steps": [
            {"do": "file.write", "path": "net/deep/first.txt", "content": "first\n"},
            {"do": "file.write", "path": "net/deep/second.txt", "content": "second\n"},
            {"do": "file.write", "path": "outside.txt", "content": "outside\n"},
            {"do": "session.create", "as": "s", "title": "Git tree folder"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.action", "label": "Expand panel"},
            {"do": "see", "on": "git.treeRow", "text": "first.txt"},
            {"do": "click", "on": "git.action", "label": "Collapse directory net/deep"},
            {"do": "gone", "on": "git.treeRow", "text": "first.txt"},
            {"do": "click", "on": "git.action", "label": "Expand directory net/deep"},
            {"do": "see", "on": "git.treeRow", "text": "first.txt"},
            {"do": "hover", "on": "git.action", "label": "Collapse directory net/deep"},
            {"do": "click", "on": "git.action", "label": "Stage all changes in net/deep"},
            {"do": "see", "on": "git.action", "label": "Generate commit message", "disabled": false},
            {"do": "reload"},
            {"do": "hover", "on": "git.treeRow", "text": "first.txt"},
            {"do": "see", "on": "git.action", "label": "Unstage net/deep/first.txt"},
            {"do": "hover", "on": "git.treeRow", "text": "second.txt"},
            {"do": "see", "on": "git.action", "label": "Unstage net/deep/second.txt"},
            {"do": "hover", "on": "git.treeRow", "text": "outside.txt"},
            {"do": "see", "on": "git.action", "label": "Stage outside.txt"}
          ]
        },
        {
          "id": "file", "kind": "path",
          "title": "Stage and unstage one file without moving another, and open its staged diff",
          "steps": [
            {"do": "file.write", "path": "src/api/client.ts", "content": "export const gitNet = 'staged';\n"},
            {"do": "file.write", "path": "notes.txt", "content": "leave unstaged\n"},
            {"do": "session.create", "as": "s", "title": "Git stage file"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.action", "label": "Stage src/api/client.ts"},
            {"do": "see", "on": "git.action", "label": "Unstage src/api/client.ts"},
            {"do": "see", "on": "git.action", "label": "Stage notes.txt"},
            {"do": "click", "on": "git.row", "text": "client.ts"},
            {"do": "see", "on": "diff.added", "text": "export const gitNet = 'staged';"},
            {"do": "click", "on": "git.action", "label": "Unstage src/api/client.ts"},
            {"do": "see", "on": "git.action", "label": "Stage src/api/client.ts"},
            {"do": "steady", "on": "git.action", "label": "Stage src/api/client.ts", "count": 1, "ms": 1500},
            {"do": "reload"},
            {"do": "see", "on": "git.action", "label": "Stage src/api/client.ts"},
            {"do": "gone", "on": "git.action", "label": "Unstage src/api/client.ts"}
          ]
        },
        {
          "id": "all", "kind": "path",
          "title": "Stage all and unstage all move every changed file",
          "steps": [
            {"do": "file.write", "path": "first.txt", "content": "first\n"},
            {"do": "file.write", "path": "second.txt", "content": "second\n"},
            {"do": "session.create", "as": "s", "title": "Git stage all"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.action", "label": "Stage all changes"},
            {"do": "see", "on": "git.action", "label": "Unstage first.txt"},
            {"do": "see", "on": "git.action", "label": "Unstage second.txt"},
            {"do": "see", "on": "git.action", "label": "Generate commit message", "disabled": false},
            {"do": "reload"},
            {"do": "see", "on": "git.action", "label": "Unstage first.txt"},
            {"do": "see", "on": "git.action", "label": "Unstage second.txt"},
            {"do": "gone", "on": "git.action", "label": "Stage all changes"},
            {"do": "click", "on": "git.action", "label": "Unstage all changes"},
            {"do": "see", "on": "git.action", "label": "Stage first.txt"},
            {"do": "see", "on": "git.action", "label": "Stage second.txt"},
            {"do": "steady", "on": "git.action", "label": "Stage all changes", "count": 1, "ms": 1500},
            {"do": "gone", "on": "git.listBusy"},
            {"do": "reload"},
            {"do": "see", "on": "git.action", "label": "Stage first.txt"},
            {"do": "see", "on": "git.action", "label": "Stage second.txt"},
            {"do": "gone", "on": "git.action", "label": "Unstage all changes"}
          ]
        },
        {
          "id": "revert-file", "kind": "path",
          "title": "Revert file asks first, Escape keeps the edit, and confirmation restores only that file",
          "steps": [
            {"do": "file.write", "path": "src/api/client.ts", "content": "export const gitNet = 'discard';\n"},
            {"do": "file.write", "path": "keep.txt", "content": "keep me\n"},
            {"do": "session.create", "as": "s", "title": "Git revert file"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "hover", "on": "git.row", "text": "client.ts"},
            {"do": "click", "on": "git.action", "label": "Revert changes in src/api/client.ts"},
            {"do": "see", "on": "dialog", "text": "Revert file changes?"},
            {"do": "press", "key": "Escape"},
            {"do": "gone", "on": "dialog"},
            {"do": "file.expect", "path": "src/api/client.ts", "contains": "'discard'"},
            {"do": "hover", "on": "git.row", "text": "client.ts"},
            {"do": "click", "on": "git.action", "label": "Revert changes in src/api/client.ts"},
            {"do": "click", "on": "dialog.button", "text": "Revert file", "exact": true},
            {"do": "file.expect", "path": "src/api/client.ts", "contains": "export const markRead"},
            {"do": "gone", "on": "git.row", "text": "client.ts"},
            {"do": "file.expect", "path": "keep.txt", "equals": "keep me\n"},
            {"do": "see", "on": "git.row", "text": "keep.txt"}
          ]
        },
        {
          "id": "revert-all", "kind": "path",
          "title": "Revert all confirms both staged and unstaged paths and removes an untracked file",
          "steps": [
            {"do": "file.write", "path": "src/api/client.ts", "content": "export const gitNet = 'discard all';\n"},
            {"do": "file.write", "path": "remove.txt", "content": "remove me\n"},
            {"do": "session.create", "as": "s", "title": "Git revert all"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.action", "label": "Stage src/api/client.ts"},
            {"do": "see", "on": "git.action", "label": "Unstage src/api/client.ts"},
            {"do": "click", "on": "files.button", "text": "Revert all", "exact": true},
            {"do": "see", "on": "dialog", "text": "Revert 2 changed files?"},
            {"do": "click", "on": "dialog.button", "text": "Cancel", "exact": true},
            {"do": "file.expect", "path": "remove.txt", "exists": true},
            {"do": "click", "on": "files.button", "text": "Revert all", "exact": true},
            {"do": "click", "on": "dialog.button", "text": "Revert all", "exact": true},
            {"do": "file.expect", "path": "src/api/client.ts", "contains": "export const markRead"},
            {"do": "file.expect", "path": "remove.txt", "exists": false},
            {"do": "gone", "on": "git.list"},
            {"do": "see", "on": "panel", "text": "Working tree clean"}
          ]
        },
        {
          "id": "fold", "kind": "path",
          "title": "Collapsing Changes hides its files without staging or discarding them",
          "steps": [
            {"do": "file.write", "path": "fold.txt", "content": "still here\n"},
            {"do": "session.create", "as": "s", "title": "Git fold"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "see", "on": "git.row", "text": "fold.txt"},
            {"do": "click", "on": "git.group", "text": "Changes"},
            {"do": "gone", "on": "git.row", "text": "fold.txt"},
            {"do": "file.expect", "path": "fold.txt", "equals": "still here\n"},
            {"do": "click", "on": "git.group", "text": "Changes"},
            {"do": "see", "on": "git.action", "label": "Stage fold.txt"}
          ]
        },
        {
          "id": "stage-error", "kind": "break",
          "title": "A refused stage restores the unstaged row and can be retried",
          "steps": [
            {"do": "file.write", "path": "retry-stage.txt", "content": "retry me\n"},
            {"do": "session.create", "as": "s", "title": "Git stage retry"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "network.block", "urls": ["*/api/git/stage*"]},
            {"do": "click", "on": "git.action", "label": "Stage retry-stage.txt"},
            {"do": "see", "on": "toast", "text": "Failed"},
            {"do": "see", "on": "git.action", "label": "Stage retry-stage.txt"},
            {"do": "gone", "on": "git.action", "label": "Unstage retry-stage.txt"},
            {"do": "file.expect", "path": "retry-stage.txt", "equals": "retry me\n"},
            {"do": "network.allow"},
            {"do": "click", "on": "git.action", "label": "Stage retry-stage.txt"},
            {"do": "see", "on": "git.action", "label": "Unstage retry-stage.txt"},
            {"do": "see", "on": "git.action", "label": "Generate commit message", "disabled": false},
            {"do": "reload"},
            {"do": "see", "on": "git.action", "label": "Unstage retry-stage.txt"}
          ]
        }
      ]
    },
    {
      "id": "commit",
      "name": "Writing a local commit",
      "sources": ["packages/ui/src/components/views/GitView.tsx", "packages/ui/src/components/views/git/CommitSection.tsx", "packages/ui/src/components/views/git/CommitInput.tsx", "packages/ui/src/components/views/git/CommitListPanel.tsx", "packages/ui/src/components/views/git/UnifiedReviewScopeView.tsx"],
      "what": "A message and staged files enable Commit; the commit records only those files and a failure keeps the draft available to retry.",
      "reach": "Stage a file in Git (or open the folded Commit section) and write in Commit message.",
      "proof": "The commit list (Changed: N menu > Commit) shows the new commit with only its staged file; unstaged work stays; failed commits retain both the message and staged file.",
      "scenarios": [
        {
          "id": "required", "kind": "break",
          "title": "Commit requires both a nonblank message and a staged file",
          "steps": [
            {"do": "file.write", "path": "required.txt", "content": "not committed\n"},
            {"do": "session.create", "as": "s", "title": "Git commit required"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.commitFold", "text": "Stage files to enable commit"},
            {"do": "see", "on": "git.action", "label": "Commit", "disabled": true},
            {"do": "see", "on": "git.action", "label": "Generate commit message", "disabled": true},
            {"do": "click", "on": "git.message"},
            {"do": "type", "text": "Message without a staged file"},
            {"do": "see", "on": "git.action", "label": "Commit", "disabled": true},
            {"do": "click", "on": "git.action", "label": "Stage required.txt"},
            {"do": "see", "on": "git.action", "label": "Commit", "disabled": false},
            {"do": "click", "on": "git.message"},
            {"do": "press", "key": "Backspace", "times": 29},
            {"do": "type", "text": "   "},
            {"do": "see", "on": "git.action", "label": "Commit", "disabled": true},
            {"do": "press", "key": "Enter", "mods": ["mod"]},
            {"do": "see", "on": "git.action", "label": "Unstage required.txt"},
            {"do": "file.expect", "path": "required.txt", "equals": "not committed\n"}
          ]
        },
        {
          "id": "selected", "kind": "path",
          "title": "Cmd/Ctrl+Enter commits only staged files and the commit list shows the committed content",
          "steps": [
            {"do": "file.write", "path": ".git/config", "content": "[core]\nrepositoryformatversion = 0\nbare = false\n[user]\nname = Relay Desk\nemail = dev@relay-desk.test\n"},
            {"do": "session.create", "as": "s", "title": "Git commit selected"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "Create new branch..."},
            {"do": "click", "on": "git.newBranch"},
            {"do": "type", "text": "net-commit"},
            {"do": "press", "key": "Enter"},
            {"do": "see", "on": "git.branch", "text": "net-commit"},
            {"do": "gone", "on": "git.newBranch"},
            {"do": "file.write", "path": "commit.txt", "content": "record this content\n"},
            {"do": "file.write", "path": "uncommitted.txt", "content": "leave this out\n"},
            {"do": "reload"},
            {"do": "click", "on": "git.action", "label": "Stage commit.txt"},
            {"do": "click", "on": "git.message"},
            {"do": "type", "text": "Record selected file"},
            {"do": "see", "on": "git.action", "label": "Commit", "disabled": false},
            {"do": "press", "key": "Enter", "mods": ["mod"]},
            {"do": "gone", "on": "git.action", "label": "Unstage commit.txt"},
            {"do": "see", "on": "git.action", "label": "Stage uncommitted.txt"},
            {"do": "click", "on": "git.scope"},
            {"do": "click", "on": "menu.option", "text": "Commit"},
            {"do": "click", "on": "git.historyCommit", "text": "Record selected file"},
            {"do": "see", "on": "git.historyFile", "path": "commit.txt"},
            {"do": "gone", "on": "git.historyFile", "path": "uncommitted.txt"},
            {"do": "click", "on": "git.historyFile", "path": "commit.txt"},
            {"do": "see", "on": "diff.added", "text": "record this content"},
            {"do": "click", "on": "git.scope"},
            {"do": "click", "on": "menu.option", "text": "Changed"},
            {"do": "see", "on": "git.row", "text": "uncommitted.txt"},
            {"do": "file.delete", "path": "uncommitted.txt"},
            {"do": "reload"},
            {"do": "gone", "on": "git.list"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "main", "index": 0},
            {"do": "see", "on": "git.branch", "text": "main"},
            {"do": "file.expect", "path": "commit.txt", "exists": false}
          ]
        },
        {
          "id": "error", "kind": "break",
          "title": "A failed commit retains its message and staged file",
          "steps": [
            {"do": "file.write", "path": ".git/config", "content": "[core]\nrepositoryformatversion = 0\nbare = false\n[user]\nname = Relay Desk\nemail = dev@relay-desk.test\n"},
            {"do": "file.write", "path": "failed-commit.txt", "content": "keep this staged\n"},
            {"do": "session.create", "as": "s", "title": "Git commit failure"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.action", "label": "Stage failed-commit.txt"},
            {"do": "click", "on": "git.message"},
            {"do": "type", "text": "Keep my commit draft"},
            {"do": "network.block", "urls": ["*/api/git/commit?*"]},
            {"do": "see", "on": "git.action", "label": "Commit", "disabled": false},
            {"do": "click", "on": "git.action", "label": "Commit"},
            {"do": "see", "on": "toast", "text": "Failed"},
            {"do": "see", "on": "git.action", "label": "Commit", "disabled": false},
            {"do": "see", "on": "git.action", "label": "Unstage failed-commit.txt"},
            {"do": "field", "on": "git.message", "equals": "Keep my commit draft"},
            {"do": "file.expect", "path": "failed-commit.txt", "equals": "keep this staged\n"}
          ]
        }
      ]
    },
    {
      "id": "branches",
      "name": "Local branches and dirty switches",
      "sources": ["packages/ui/src/components/views/GitView.tsx", "packages/ui/src/components/views/git/GitHeader.tsx", "packages/ui/src/components/views/git/BranchSelector.tsx", "packages/ui/src/components/views/git/branchName.ts", "packages/ui/src/components/views/git/DirtyBranchSwitchDialog.tsx"],
      "what": "Create and switch local branches; switching with uncommitted work waits for an explicit commit or revert.",
      "reach": "The branch name in the Git header.",
      "proof": "The header follows checkout, cancelled switches leave files intact, revert removes the edits, and commit keeps them on the source branch.",
      "scenarios": [
        {
          "id": "create-switch", "kind": "path",
          "title": "Creating a branch sanitizes its name, checks it out, and the picker switches back",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Git branch create"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "Create new branch..."},
            {"do": "click", "on": "git.newBranch"},
            {"do": "type", "text": "net branch"},
            {"do": "press", "key": "Enter"},
            {"do": "see", "on": "git.branch", "text": "net-branch"},
            {"do": "gone", "on": "git.newBranch"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "main", "index": 0},
            {"do": "see", "on": "git.branch", "text": "main"},
            {"do": "reload"},
            {"do": "see", "on": "git.branch", "text": "main"}
          ]
        },
        {
          "id": "empty", "kind": "break",
          "title": "A missing branch search says so, and an empty new branch cannot be created",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Git branch empty"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.branchSearch"},
            {"do": "type", "text": "zzzz-no-such-branch"},
            {"do": "see", "on": "git.option", "text": "No local branches"},
            {"do": "click", "on": "git.option", "text": "Create new branch..."},
            {"do": "see", "on": "git.createBranch", "disabled": true},
            {"do": "click", "on": "git.newBranch"},
            {"do": "press", "key": "Escape"},
            {"do": "gone", "on": "git.newBranch"},
            {"do": "press", "key": "Escape"},
            {"do": "see", "on": "git.branch", "text": "main"}
          ]
        },
        {
          "id": "dirty-cancel", "kind": "break",
          "title": "Dismissing a dirty branch switch preserves the branch and file",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Git branch cancel"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "Create new branch..."},
            {"do": "click", "on": "git.newBranch"},
            {"do": "type", "text": "net-cancel"},
            {"do": "press", "key": "Enter"},
            {"do": "see", "on": "git.branch", "text": "net-cancel"},
            {"do": "gone", "on": "git.newBranch"},
            {"do": "file.write", "path": "dirty.txt", "content": "do not lose me\n"},
            {"do": "reload"},
            {"do": "see", "on": "git.row", "text": "dirty.txt"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "main", "index": 0},
            {"do": "see", "on": "dialog", "text": "Uncommitted changes"},
            {"do": "press", "key": "Escape"},
            {"do": "gone", "on": "dialog"},
            {"do": "see", "on": "git.branch", "text": "net-cancel"},
            {"do": "file.expect", "path": "dirty.txt", "equals": "do not lose me\n"},
            {"do": "file.delete", "path": "dirty.txt"},
            {"do": "reload"},
            {"do": "gone", "on": "git.list"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "main", "index": 0},
            {"do": "see", "on": "git.branch", "text": "main"}
          ]
        },
        {
          "id": "dirty-revert", "kind": "path",
          "title": "Revert and switch discards the changed file before checkout",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Git branch revert"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "panel.surface", "surface": "git"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "Create new branch..."},
            {"do": "click", "on": "git.newBranch"},
            {"do": "type", "text": "net-revert"},
            {"do": "press", "key": "Enter"},
            {"do": "see", "on": "git.branch", "text": "net-revert"},
            {"do": "gone", "on": "git.newBranch"},
            {"do": "file.write", "path": "dirty.txt", "content": "discard before switching\n"},
            {"do": "reload"},
            {"do": "see", "on": "git.row", "text": "dirty.txt"},
            {"do": "click", "on": "git.branch"},
            {"do": "click", "on": "git.option", "text": "main", "index": 0},
            {"do": "click", "on": "dialog.button", "text": "Revert and switch", "exact": true},
            {"do": "see", "on": "git.branch", "text": "main"},
            {"do": "file.expect", "path": "dirty.txt", "exists": false},
            {"do": "gone", "on": "git.list"}
          ]
        },
        {
          "id": "dirty-commit", "kind": "path",

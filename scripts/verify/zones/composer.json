{
  "zone": "composer",
  "name": "Composer",
  "sources": ["packages/ui/src/components/chat/ChatInput.tsx", "packages/ui/src/components/chat/composer/input/", "packages/ui/src/components/chat/composer/", "packages/ui/src/components/chat/ModelControls.tsx"],
  "features": [
    {
      "id": "send",
      "name": "Sending a prompt",
      "sources": ["packages/ui/src/components/chat/ChatInput.tsx", "packages/ui/src/components/chat/composer/input/", "packages/ui/src/components/chat/composer/keyboardPolicy.ts", "packages/ui/src/components/chat/composer/submit/buildOutgoingMessage.ts", "packages/ui/src/components/chat/composer/ui/ComposerActionButtons.tsx", "packages/ui/src/components/chat/composer/ui/ComposerFooter.tsx"],
      "what": "The user types a prompt and sends it; it lands in the chat and the agent answers.",
      "reach": "Open a session, type in the composer, press Enter or click Send.",
      "proof": "The prompt shows as a user bubble, the composer empties, the answer follows, Send is disabled while the box is empty.",
      "scenarios": [
        {
          "id": "enter",
          "kind": "path",
          "title": "Enter sends the prompt, the composer empties and the answer arrives",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer send"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "Explain the call frame"},
            {"do": "press", "key": "Enter"},
            {"do": "see", "on": "chat.userBubble", "text": "Explain the call frame"},
            {"do": "editor", "empty": true},
            {"do": "see", "on": "chat.answer", "text": "bytecode virtual machine"},
            {"do": "session.idle", "session": "s"},
            {"do": "see", "on": "composer.send", "disabled": true}
          ]
        },
        {
          "id": "button",
          "kind": "path",
          "title": "Send is disabled while the box is empty, enabled with text, and sends on click",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer button"},
            {"do": "open", "session": "s"},
            {"do": "see", "on": "composer.send", "disabled": true},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "Sent with the button"},
            {"do": "see", "on": "composer.send", "disabled": false},
            {"do": "click", "on": "composer.send"},
            {"do": "see", "on": "chat.userBubble", "text": "Sent with the button"},
            {"do": "see", "on": "chat.answer", "text": "bytecode virtual machine"}
          ]
        },
        {
          "id": "blank",
          "kind": "break",
          "title": "Only spaces and newlines send nothing",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer blank"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "   "},
            {"do": "press", "key": "Enter", "mods": ["shift"]},
            {"do": "see", "on": "composer.send", "disabled": true},
            {"do": "press", "key": "Enter"},
            {"do": "steady", "on": "chat.userBubble", "count": 0, "ms": 1500}
          ]
        },
        {
          "id": "shift-enter",
          "kind": "path",
          "title": "Shift+Enter starts a new line and sends nothing",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer newline"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "line one"},
            {"do": "press", "key": "Enter", "mods": ["shift"]},
            {"do": "type", "text": "line two"},
            {"do": "editor", "equals": "line one\nline two"},
            {"do": "steady", "on": "chat.userBubble", "count": 0, "ms": 1000},
            {"do": "press", "key": "Enter"},
            {"do": "see", "on": "chat.userBubble", "text": "line two"},
            {"do": "editor", "empty": true}
          ]
        },
        {
          "id": "alt-enter",
          "kind": "path",
          "title": "Alt+Enter starts a new line and sends nothing",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer alt enter"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "first line"},
            {"do": "press", "key": "Enter", "mods": ["alt"]},
            {"do": "type", "text": "second line"},
            {"do": "editor", "equals": "first line\nsecond line"},
            {"do": "steady", "on": "chat.userBubble", "count": 0, "ms": 1000}
          ]
        }
      ]
    },
    {
      "id": "markdown",
      "name": "Typing Markdown",
      "what": "The composer helps with Markdown: a numbered list continues on a new line, a selection gets wrapped in the mark typed over it, three backticks open a code block.",
      "reach": "Type in the composer.",
      "proof": "The composer's text holds the next number, the wrapped selection, the closed fence.",
      "scenarios": [
        {
          "id": "list",
          "kind": "path",
          "title": "Shift+Enter after a numbered item starts the next number",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer list"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "1. first"},
            {"do": "press", "key": "Enter", "mods": ["shift"]},
            {"do": "type", "text": "second"},
            {"do": "editor", "equals": "1. first\n2. second"}

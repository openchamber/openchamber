        },
        {
          "id": "wrap",
          "kind": "path",
          "title": "A mark typed over selected text wraps it",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer wrap"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "important"},
            {"do": "press", "key": "a", "mods": ["mod"]},
            {"do": "press", "key": "*"},
            {"do": "editor", "equals": "*important*"}
          ]
        },
        {
          "id": "fence",
          "kind": "path",
          "title": "A third backtick at the start of a line closes the code block",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer fence"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},

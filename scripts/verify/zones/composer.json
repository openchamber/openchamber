            {"do": "press", "key": "`"},
            {"do": "type", "text": "code"},
            {"do": "editor", "equals": "```\ncode\n```"}
          ]
        }
      ]
    },
    {
      "id": "shell",
      "name": "Shell mode",
      "what": "! at the start of an empty composer turns it into a shell command line; Escape or Backspace on an empty line turns it back.",
      "reach": "Press ! in an empty composer.",
      "proof": "The placeholder reads Enter shell command..., the ! is not in the text; after Escape or Backspace the chat placeholder is back.",
      "scenarios": [
        {
          "id": "escape",
          "kind": "path",
          "title": "! opens shell mode without typing it, Escape leaves it",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer shell"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "press", "key": "!"},
            {"do": "see", "on": "composer.editorAs", "placeholder": "Enter shell command..."},
            {"do": "editor", "empty": true},
            {"do": "press", "key": "Escape"},
            {"do": "gone", "on": "composer.editorAs", "placeholder": "Enter shell command..."},
            {"do": "editor", "empty": true}
          ]
        },
        {
          "id": "backspace",
          "kind": "path",
          "title": "Backspace on an empty shell line leaves shell mode",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer shell backspace"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "press", "key": "!"},
            {"do": "see", "on": "composer.editorAs", "placeholder": "Enter shell command..."},
            {"do": "press", "key": "Backspace"},
            {"do": "gone", "on": "composer.editorAs", "placeholder": "Enter shell command..."}
          ]
        },
        {
          "id": "mid-text",
          "kind": "break",
          "title": "! after text is just a character",
          "steps": [
            {"do": "session.create", "as": "s", "title": "Composer shell mid text"},
            {"do": "open", "session": "s"},
            {"do": "click", "on": "composer.editor"},
            {"do": "type", "text": "wow"},
            {"do": "type", "text": "!"},
            {"do": "editor", "equals": "wow!"},
            {"do": "see", "on": "composer.editorAs", "placeholder": "Enter shell command...", "count": 0, "timeout": 1}
          ]
        }
      ]
    },
    {
      "id": "draft",
      "name": "Drafts",
      "sources": ["packages/ui/src/components/chat/ChatInput.tsx", "packages/ui/src/components/chat/composer/input/", "packages/ui/src/components/chat/composer/state/useComposerDraft.ts", "packages/ui/src/hooks/useUnconfirmedSendRecovery.ts", "packages/ui/src/components/chat/composer/ui/DraftTargetSelectors.tsx", "packages/ui/src/components/chat/composer/state/useDraftTarget.ts"],
      "what": "Text typed and not sent stays with its session.",

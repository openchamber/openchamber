    {
      "id": "failures",
      "name": "Failed discovery and provider writes",
      "sources": ["packages/ui/src/components/sections/providers/ProvidersPage.tsx", "packages/ui/src/components/sections/providers/CustomProviderForm.tsx"],
      "what": "A failed model discovery or save reports the failure and leaves the draft editable.",
      "reach": "Fill a custom provider draft and use Find models or Save provider while that request is blocked.",
      "proof": "The error appears, the manual model remains, and saving is available again.",
      "scenarios": [
        {
          "id": "discovery",
          "kind": "break",
          "title": "A discovery request that fails keeps the manually entered model and allows retry",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Connect provider"},

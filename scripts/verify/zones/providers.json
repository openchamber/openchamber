{
  "zone": "providers",
  "name": "Provider settings",
  "sources": ["packages/ui/src/components/sections/providers/ProvidersPage.tsx"],
  "features": [
    {
      "id": "browse",
      "name": "Finding and opening providers",
      "sources": ["packages/ui/src/components/sections/providers/ProvidersPage.tsx", "packages/ui/src/components/sections/providers/ProviderGrid.tsx", "packages/ui/src/components/sections/providers/ProviderConnectPicker.tsx", "packages/ui/src/components/sections/providers/connectableProviders.ts"],
      "what": "Search finds configured providers and new connections; Back returns to the grid without changing the chat's model.",
      "reach": "Settings > Providers, then a provider card or Connect provider.",
      "proof": "The matching card opens its models, an unmatched query says so, clearing restores cards, and a custom-provider search opens its form.",
      "scenarios": [
        {
          "id": "grid-search",
          "kind": "path",
          "title": "Provider search filters cards, an unmatched query recovers, and opening a card leaves the chat model alone",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.search"},
            {"do": "type", "text": "zzzz-no-provider"},
            {"do": "see", "on": "dialog", "text": "No providers"},
            {"do": "click", "on": "providers.search", "clicks": 3},
            {"do": "type", "text": "Offline"},
            {"do": "see", "on": "providers.button", "text": "Offline fixture"},
            {"do": "click", "on": "providers.button", "text": "Offline fixture"},
            {"do": "see", "on": "providers.model", "text": "Offline fixture, server down"},
            {"do": "click", "on": "settings.close"},
            {"do": "see", "on": "composer.model", "text": "Fixture stream, seeding speed"}
          ]
        },
        {
          "id": "connect-search",
          "kind": "path",
          "title": "Connect lists popular and other providers, search finds the custom form, and Back discards its draft",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Connect provider"},
            {"do": "see", "on": "providers.button", "text": "GPT models, sign in with ChatGPT"},
            {"do": "click", "on": "providers.button", "text": "Show all providers"},
            {"do": "see", "on": "providers.button", "text": "Amazon Bedrock"},
            {"do": "click", "on": "providers.search"},
            {"do": "type", "text": "zzzz-no-provider"},
            {"do": "see", "on": "dialog", "text": "No providers found"},
            {"do": "click", "on": "providers.search", "clicks": 3},
            {"do": "type", "text": "custom"},
            {"do": "click", "on": "providers.button", "text": "Custom provider", "exact": true},
            {"do": "click", "on": "providers.field", "label": "Provider ID"},
            {"do": "type", "text": "discarded-provider"},
            {"do": "click", "on": "providers.button", "text": "Back", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Custom provider"},
            {"do": "see", "on": "providers.field", "label": "Provider ID"},
            {"do": "click", "on": "providers.button", "text": "Save provider", "exact": true},
            {"do": "see", "on": "providers.invalid", "label": "Provider ID"}
          ]
        }
      ]
    },
    {
      "id": "models",
      "name": "Model filtering and visibility",
      "what": "Models can be found by name or ID and hidden individually or all together from the chat picker.",
      "reach": "Settings > Providers > Performance fixture.",
      "proof": "The filter narrows the list and recovers from no matches; hidden models leave the chat picker, stay hidden after reload, and Show all restores them.",
      "scenarios": [
        {
          "id": "filter",
          "kind": "path",
          "title": "The model filter finds a model by ID and recovers from no matches",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Perf"},
            {"do": "click", "on": "providers.filter"},
            {"do": "type", "text": "zzzz-no-model"},
            {"do": "see", "on": "dialog", "text": "No models match this filter."},
            {"do": "see", "on": "providers.model", "count": 0},
            {"do": "click", "on": "providers.filter", "clicks": 3},
            {"do": "type", "text": "think- 30s"},
            {"do": "see", "on": "providers.model", "count": 1},
            {"do": "see", "on": "providers.model", "text": "Fixture silence, 30s"},
            {"do": "click", "on": "providers.filter", "clicks": 3},
            {"do": "press", "key": "Backspace"},
            {"do": "see", "on": "providers.model", "text": "Fixture stream, seeding speed"}
          ]
        },
        {
          "id": "hide-one",
          "kind": "path",
          "title": "Hiding one model removes it from the chat picker across reloads",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Perf"},
            {"do": "click", "on": "providers.filter"},
            {"do": "type", "text": "code-20000cps"},
            {"do": "click", "on": "providers.visibility", "label": "Hide model"},
            {"do": "see", "on": "providers.visibility", "label": "Show model"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "composer.model"},
            {"do": "click", "on": "picker.search"},
            {"do": "type", "text": "Fixture code, seeding speed"},
            {"do": "steady", "on": "picker.option", "text": "Fixture code, seeding speed", "count": 0, "ms": 700}
          ]
        },
        {
          "id": "hide-show-all",
          "kind": "path",
          "title": "Hide all hides every model even with a filter, and Show all restores the picker",
          "steps": [
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Perf"},
            {"do": "click", "on": "providers.filter"},
            {"do": "type", "text": "code-20000cps"},
            {"do": "click", "on": "providers.button", "text": "Hide all", "exact": true},
            {"do": "click", "on": "providers.filter"},
            {"do": "click", "on": "providers.filter", "clicks": 3},
            {"do": "press", "key": "Backspace"},
            {"do": "see", "on": "providers.model", "text": "Fixture stream, seeding speed"},
            {"do": "see", "on": "providers.visibility", "label": "Hide model", "count": 0},
            {"do": "click", "on": "providers.button", "text": "Show all", "exact": true},
            {"do": "see", "on": "providers.visibility", "label": "Show model", "count": 0},
            {"do": "click", "on": "settings.close"},
            {"do": "click", "on": "composer.model"},
            {"do": "click", "on": "picker.search"},
            {"do": "type", "text": "Fixture code, seeding speed"},
            {"do": "see", "on": "picker.option", "text": "Fixture code, seeding speed"}
          ]
        }
      ]
    },
    {
      "id": "custom",
      "name": "Custom provider drafts and validation",
      "sources": ["packages/ui/src/components/sections/providers/ProvidersPage.tsx", "packages/ui/src/components/sections/providers/CustomProviderForm.tsx", "packages/ui/src/components/sections/providers/CustomProviderModelRow.tsx", "packages/ui/src/components/sections/providers/custom-provider-form.ts"],
      "what": "A custom provider draft chooses a protocol and models, validates connection details, headers and certificates, and keeps edits when saving fails.",
      "reach": "Settings > Providers > Connect provider > Custom provider.",
      "proof": "Invalid fields and duplicate rows show errors; model rows add, collapse and remove; protocol changes show their selection; a failed write keeps the form.",
      "scenarios": [
        {
          "id": "edit",
          "kind": "path",
          "title": "Editing a project provider saves its name in place, keeps its adapter and headers, and reopens with the new name after reload",
          "steps": [
            {"do": "file.write", "path": "opencode.json", "content": "{\"providers\":{\"editable\":{\"package\":\"@opencode/ai/providers/openai-compatible\",\"name\":\"Editable fixture\",\"settings\":{\"baseURL\":\"http://localhost:1/v1\",\"apiKey\":\"unused\"},\"headers\":{\"X-Verify\":\"keep-me\"},\"models\":{\"manual\":{\"modelID\":\"manual\",\"name\":\"Manual fixture\",\"limit\":{\"context\":32000,\"output\":2000}}}}}}"},
            {"do": "open"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Editable fixture"},
            {"do": "click", "on": "providers.button", "text": "Edit", "exact": true},
            {"do": "see", "on": "providers.field", "label": "Provider ID", "disabled": true},
            {"do": "click", "on": "providers.field", "label": "Display name"},
            {"do": "click", "on": "providers.field", "label": "Display name", "clicks": 3},
            {"do": "type", "text": "Renamed fixture"},
            {"do": "click", "on": "providers.button", "text": "Update provider", "exact": true},
            {"do": "file.expect", "path": "opencode.json", "contains": "Renamed fixture"},
            {"do": "file.expect", "path": "opencode.json", "contains": "@opencode/ai/providers/openai-compatible"},
            {"do": "file.expect", "path": "opencode.json", "contains": "keep-me"},
            {"do": "see", "on": "providers.button", "text": "Edit", "exact": true},
            {"do": "see", "on": "providers.model", "text": "Manual fixture"},
            {"do": "click", "on": "settings.close"},
            {"do": "reload"},
            {"do": "click", "on": "sidebar.settings"},
            {"do": "click", "on": "settings.search", "timeout": 60},
            {"do": "type", "text": "providers"},
            {"do": "click", "on": "settings.searchResult", "text": "Available models", "exact": true},
            {"do": "click", "on": "providers.button", "text": "Renamed fixture"},
            {"do": "see", "on": "providers.heading", "text": "Renamed fixture", "exact": true}
          ]
        },
        {
          "id": "required",
          "kind": "break",

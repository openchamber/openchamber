{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "packages/mobile/android/app/src/main/assets/public/**",
    "packages/mobile/ios/App/App/public/**",
    "packages/sdk/examples/**",
    "fixtures/knip-class-members/**",
  ],
  "workspaces": {
    ".": {
      "entry": [
        "oxlint.config.ts",
        "oxlint.anti-slop.config.ts",
        "postcss.config.js",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "*.{js,cjs,mjs,ts}",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/apps/renderVSCodeApp.tsx",
        "src/**/*.bench.{ts,tsx}",
        "src/**/*.{test,spec}.{js,cjs,mjs,jsx,ts,tsx}",
        "src/**/__tests__/**/*.{js,cjs,mjs,jsx,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreMembers": [
        "getDerivedStateFromError",
        "componentDidCatch",
        "componentDidUpdate",
        "render",
        "code",
        "status",
        "remoteName",
        "reason",
        "operation",
        "getDictationId",
        "getFinalSeq",
        "hasSegments",
        "clearAll",
        "enqueueSegment",
        "finish",
        "cancel",
        "resetAndWrite",
        "setTheme",
        "setFont",
        "pasteFromClipboard",
        "refresh",
        "scrollLines",
        "selectWordAt",
        "extendSelectionTo", "getSelectionPosition",
        "getActivePrefixTarget",
        "apply",
        "clearBootstrapDemand",
        "subscribeAll",
        "configure",
        "subscribe",
        "invalidateDirectory"
      ]
    },
    "packages/web": {
      "entry": [
        "src/mobile-main.tsx",
        "src/mini-chat-main.tsx",
        "src/main.tsx",
        "src/sw.ts",
        "bin/**/*.{test,spec}.{js,cjs,mjs}",
        "server/**/*.{test,spec}.{js,cjs,mjs}",
        "server/lib/opencode/listener-service.fixture.mjs",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": [
        "bin/**/*.js",
        "server/**/*.{js,mjs,cjs}",
        "src/**/*.{ts,tsx}"
      ],
      "ignoreMembers": [
        "appendPcm16",
        "commit",
        "clear",
        "close",
        "free",
        "synthesize",
        "processChunk"
      ]
    },
    "packages/electron": {
      "entry": [
        "entry.mjs",
        "main.mjs",
        "preload.mjs",
        "browser-panel-preload.cjs",
        "tray.mjs",
        "ssh-manager.mjs",
        "opencode-cwd.mjs",
        "*.{test,spec}.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ],
      "project": [
        "*.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ]
    },
    "packages/vscode": {
      "entry": [
        "webview/main.tsx",
        "src/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}",
        "webview/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "webview/**/*.{ts,tsx}"
      ]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/ui/index.ts",
        "src/schemas.ts",
        "src/**/*.{test,spec}.ts",
        "scripts/**/*.{test,spec}.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/mobile": {
      "entry": [
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    }
  }
}

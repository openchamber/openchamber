{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Kyiv",
  "minimumReleaseAge": "1 day",
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Group non-major development dependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development dependencies"
    },
    {
      "description": "androidx.core 1.17+ needs compileSdk 36+ (1.19 needs 37 and AGP 9.1); lift together with the Android SDK baseline",
      "matchPackageNames": ["androidx.core:core"],
      "allowedVersions": "<1.17.0"
    }
  ]
}

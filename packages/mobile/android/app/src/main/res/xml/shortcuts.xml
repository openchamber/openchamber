<?xml version="1.0" encoding="utf-8"?>
<!-- The app-icon quick action, mirroring the iOS UIApplicationShortcutItem in Info.plist.
     It opens the same openchamber:// deep link the web layer routes; the icons are plain
     vector glyphs rather than the adaptive launcher icon, which renders as an empty square
     in the menu. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new-session"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_session"
        android:shortcutShortLabel="@string/shortcut_new_session">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.openchamber.app"
            android:targetClass="com.openchamber.app.MainActivity"
            android:data="openchamber://new" />
    </shortcut>
</shortcuts>

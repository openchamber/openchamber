<?xml version="1.0" encoding="utf-8"?>
<!-- iOS parity: the small widget is a title, the attention count and the two entry points. The
     actions stack instead of sitting side by side because "New session" cannot share a 2-cell
     width with another label without wrapping mid-word. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="top"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- One header row: the title and the count share a line, so the actions below get the
         height a 2x2 cell can spare instead of it going to a second text line. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_chat"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_attention"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text=""
            android:textColor="#FFFF9F0A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/quick_new"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_accent"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/widget_new_session"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quick_attention"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/widget_attention"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp" />
</LinearLayout>

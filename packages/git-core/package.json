{
  "name": "@openchamber/git-core",
  "version": "1.16.3",
  "private": true,
  "description": "Shared pull-request resolution and worktree-related git helpers used by the web server and the VS Code extension host.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "bun x eslint --ext .ts src __tests__"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.4"
  }
}

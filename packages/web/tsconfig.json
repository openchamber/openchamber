{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": [
      "vite/client",
      "@types/dom-speech-recognition",
      "node"
    ],
    "paths": {
      "@openchamber/sdk": [
        "../sdk/src/index.ts"
      ],
      "@openchamber/sdk/schemas": [
        "../sdk/src/schemas.ts"
      ],
      "@/*": [
        "../ui/src/*",
        "./src/*"
      ],
      "@web/*": [
        "./src/*"
      ],
      "@openchamber/ui/*": [
        "../ui/src/*"
      ],
      "@openchamber/web/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "../ui/src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../ui/tsconfig.build.json"
    }
  ]
}

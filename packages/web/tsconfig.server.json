{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noCheck": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "erasableSyntaxOnly": true,
    "rootDir": ".",
    "outDir": "build",
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "types": ["node"]
  },
  "include": ["server/**/*.js", "server/**/*.ts", "bin/**/*.js", "bin/**/*.ts"],
  "exclude": [
    "**/*.d.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.test-support.*",
    "**/*.fixture.*",
    "**/test-support/**",
    "**/*-live-support.js",
    "server/built-in-extensions/**",
    "build",
    "node_modules"
  ]
}

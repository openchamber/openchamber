{
  "name": "@openchamber/example-tools-only",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "tools-only",
        "name": "Tool Gallery",
        "icon": "tools"
      },
      "tools": [
        {
          "match": "example_findings",
          "name": "Code review",
          "icon": "search",
          "title": "Review · {input.scope}",
          "subtitle": "{output.summary}",
          "output": "table",
          "columns": ["severity", "file", "finding"]
        },
        {
          "match": "example_checks",
          "name": "Project checks",
          "icon": "checkbox-circle",
          "title": "Checks · {input.project}",
          "subtitle": "{output.summary}",
          "output": "table",
          "columns": ["check", "status", "detail"]
        },
        {
          "match": "example_issue",
          "name": "Issue",
          "icon": "bug",
          "title": "Issue · {input.key}",
          "output": "card",
          "card": {
            "label": "{output.key} · {output.fields.issuetype.name}",
            "title": "{output.fields.summary}",
            "status": {
              "value": "{output.fields.status.name}",
              "tones": { "In Progress": "info", "Blocked": "error", "Done": "success" }
            },
            "fields": [
              { "label": "Assignee", "value": "{output.fields.assignee.displayName}" },
              { "label": "Priority", "value": "{output.fields.priority.name}" }
            ],
            "link": { "label": "Open in tracker", "url": "{output.url}" }
          }
        },
        {
          "match": "example_issues",
          "name": "Issues",
          "icon": "bug",
          "title": "Issues · {input.query}",
          "subtitle": "{output.summary}",
          "output": "card",
          "card": {
            "label": "{output.key}",
            "title": "{output.fields.summary}",
            "status": {
              "value": "{output.fields.status.name}",
              "tones": { "In Progress": "info", "Blocked": "error", "Done": "success" }
            },
            "fields": [{ "label": "Assignee", "value": "{output.fields.assignee.displayName}" }]
          }
        },
        {
          "match": "example_*",
          "name": "Tool result",
          "icon": "tools",
          "output": "json"
        }
      ]
    }
  },
  "dependencies": {
    "@openchamber/sdk": "workspace:*"
  }
}

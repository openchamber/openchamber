{
  "metadata": {
    "id": "jetbrains-light",
    "name": "JetBrains",
    "variant": "light",
    "description": "JetBrains IDE-inspired colors for OpenChamber - light variant",
    "version": "1.0.0",
    "author": "Artem Evsevev, adapted for OpenChamber",
    "tags": [
      "light",
      "jetbrains",
      "ide",
      "blue"
    ]
  },
  "colors": {

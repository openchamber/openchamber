    "syntax": {
      "base": {
        "foreground": "#393a34",
        "comment": "#a0ada0",
        "keyword": "#1e754f",
        "string": "#b56959",
        "number": "#2f798a",
        "function": "#59873a",
        "variable": "#b07d48",
        "type": "#2e808f",
        "operator": "#ab5959"
      },
      "tokens": {
        "commentDoc": "#575653",
        "keywordImport": "#D14D41",
        "storageModifier": "#4385BE",
        "method": "#879A39",
        "variableProperty": "#998418",
        "variableOther": "#879A39",
        "className": "#5a6aa6"
      },
      "highlights": {
        "lineNumber": "#393a3450",
        "lineNumberActive": "#4e4f47"
      }
    },
    "pr": {
      "draft": "#a0ada0",
      "merged": "#5843be"
    },
    "chat": {
      "userMessageBackground": "#f4f1f1",
      "divider": "#00000015"
    },
    "markdown": {
      "link": "#1e754f",
      "linkHover": "#1c6b48",

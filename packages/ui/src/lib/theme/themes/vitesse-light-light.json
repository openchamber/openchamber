{
  "metadata": {
    "id": "vitesse-light-light",
    "name": "Vitesse Light",
    "variant": "light",
    "description": "Converted from VS Code theme",
    "version": "1.0.0",
    "tags": [
      "light",
      "converted",
      "vscode"
    ]
  },
  "colors": {
    "primary": {
      "base": "#1c6b48",
      "hover": "#1c6b48",
      "active": "#228056",
      "muted": "#1c6b4880"
    },
    "surface": {
      "background": "#ffffff",
      "foreground": "#2c2c28",
